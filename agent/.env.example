# 에이전트 서비스 환경변수.
# 이 파일을 복사해 .env 를 만들고 실제 값을 채운다.
# .env 는 .gitignore 에 있어 커밋되지 않는다. 키는 절대 커밋·공유하지 않는다.

# Supabase 접속 정보
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-or-secret-key

# Postgres 직접 접속 문자열. migration과 벡터 확장 확인에 사용한다.
# Supabase 대시보드 > Project Settings > Database > Connection string > URI
SUPABASE_DB_URL=postgresql://postgres:password@host:5432/postgres

# 생성·임베딩·웹 검색
OPENAI_API_KEY=your-openai-api-key

# 교차 표본 감사
NVIDIA_API_KEY=your-nvidia-api-key

# 공공데이터포털. 국가직무능력표준의 능력단위 정의를 받는다.
# https://www.data.go.kr/data/15063879/openapi.do 에서 활용신청 후 일반 인증키(Decoding)
DATA_GO_KR_API_KEY=your-data-go-kr-api-key

# 동시에 보낼 모델 요청 수. 비우면 4다.
# 계정 등급의 분당 요청 한도에 맞춰 올린다. 한도를 넘기면 429 가 쏟아지고
# 그만큼의 표현이 결과에서 빠진다.
# CAREERSIGNAL_MODEL_WORKERS=4

# 확장 단계에서 사용
# GEMINI_API_KEY=
# YOUTUBE_API_KEY=

# FastAPI 가 열 포트. 배포 플랫폼(Render 등)은 PORT 를 직접 주입하므로 값을 고정하지
# 않는다. 로컬에서만 쓰고, 비우면 8000 을 사용한다. 실행 명령은 agent/Procfile 이다.
PORT=8000

# ---------------------------------------------------------------- 배포 (Phase 23-1)
# 이 서비스는 브라우저가 직접 부르지 않는다. Express 만 AGENT_URL 로 부른다.
# 배포에서는 위 키를 전부 플랫폼 환경변수로 넣고 이 파일의 예시값은 커밋하지 않는다.
# 서비스 정의는 server/render.yaml 에 있다.
#
# SUPABASE_DB_URL 은 scripts/load_demo_seed.py 도 읽는다. 데모 시드의 생성·적재·
# 되돌리기 명령은 data/demo_seed/README.md 에 있다.
