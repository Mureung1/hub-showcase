# 이 파일을 .env로 복사한 뒤 실제 값으로 채운다. .env는 git에 올라가지 않는다.
# Supabase 프로젝트 설정 > Database > Connection string(URI)에서 복사한다.
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# 대체 운동 추천에 쓰는 Claude API 키 (https://console.anthropic.com 에서 발급). 없으면 결정론적 폴백으로 동작한다.
ANTHROPIC_API_KEY=""

PORT=3001
