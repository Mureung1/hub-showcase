# server/.env 로 복사해서 사용 (실제 .env는 커밋 금지)
PORT=4000
DATABASE_URL=postgresql://rbgus:1234@localhost:5432/hub

# 관리형 DB(Supabase 등)는 SSL을 요구한다. 로컬 Docker는 SSL이 없으므로 비워둔다.
# 배포에서는 true.
DATABASE_SSL=

# 허용할 프론트 출처. 쉼표로 여러 개 지정 가능.
# 비우면 모든 출처 허용(로컬 개발 기본값) — 배포에서는 반드시 Vercel 도메인을 넣는다.
# 예: https://hub-xxxx.vercel.app
CORS_ORIGIN=

# 만료 처리 주기(ms). 기본 60000
EXPIRY_INTERVAL_MS=60000

# FCM 서비스 계정 키 — 둘 중 하나만 설정하면 된다(JSON이 우선).
# 미설정 시 푸시는 비활성되고 인앱 알림만 동작한다.
#
# 배포용: 키 JSON 내용을 한 줄로 붙여넣는다(줄바꿈이 들어가면 파싱에 실패한다).
FIREBASE_SERVICE_ACCOUNT_JSON=
#
# 로컬용: 레포 밖에 둔 키 파일 경로.
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
FIREBASE_SERVICE_ACCOUNT_PATH=

# [부하 테스트 전용] 1로 두면 락 미적용 재고 차감 경로로 동작한다(오버셀 재현용).
# 운영·시연 환경에서는 절대 켜지 않는다. docs/부하테스트.md 참고
UNSAFE_STOCK=
