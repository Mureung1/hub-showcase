PORT=4000
DB_PATH=./data/specfit.db

# 배포 시 프론트가 다른 origin에서 호출할 수 있도록 허용할 origin. 콤마로 여러 개 지정 가능
# (예: https://specfit.vercel.app,http://localhost:5173). 비워두면(로컬 개발) 지금처럼 전체 허용.
ALLOWED_ORIGIN=

# Supabase 프로젝트(Settings → API)에서 확보 — 대시보드엔 anon/service_role이 "Publishable key"/"Secret key"로
# 표시될 수 있음(Supabase 개편, 값의 성격은 동일). 북마크(#20) requireSupabaseAuth 미들웨어 + 북마크 CRUD용.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
