PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com에서 발급받는 API 키. 브랜드 요약/홍보글/공지사항/브리핑
# 문구 생성에 사용 (claude-sonnet-5).
ANTHROPIC_API_KEY=

# 온보딩 "채널 연결"에서 쓰는 네이버 로그인(OAuth). developers.naver.com에서
# 애플리케이션을 등록하고 발급받는다. Redirect URI는 아래 NAVER_REDIRECT_URI와
# 정확히 동일하게 등록해야 한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:4000/api/auth/naver/callback
