DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
JWT_SECRET="change-me-to-a-long-random-string"

# Supabase Storage (인증 영상 저장, S3 호환 API) — 클라이언트가 presigned URL로
# 직접 업로드하므로 서버는 파일 바이너리를 중계하지 않고 이 자격증명으로 URL만 발급한다.
# S3 액세스 키는 Supabase 대시보드 > Storage > S3 Connection에서 발급.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_S3_ACCESS_KEY_ID="supabase-s3-access-key-id"
SUPABASE_S3_SECRET_ACCESS_KEY="supabase-s3-secret-access-key"
SUPABASE_S3_REGION="ap-northeast-2"
SUPABASE_STORAGE_BUCKET="we-should-do-videos"
