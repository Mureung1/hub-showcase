# server/.env 로 복사해서 실제 값을 채운다. server/.env는 .gitignore에 포함되어 커밋되지 않는다.

# 서버 포트
PORT=4000

# FE 개발 서버 주소 (CORS 허용 origin). 배포 후에는 실제 FE 배포 URL로 교체.
CORS_ORIGIN=http://localhost:5173

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AI 챗봇 연동 API (아직 어떤 서비스를 쓸지 미정 — docs/checklist.md "동료 피드백 반영" 항목 참고)
LLM_API_KEY=
