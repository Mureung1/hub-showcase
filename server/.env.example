# Express 서버 환경변수. 이 파일을 복사해 .env 를 만들고 실제 값을 채운다.
# .env 는 .gitignore 에 있어 커밋되지 않는다. 키는 절대 커밋·공유하지 않는다.
#
# Express는 저장된 분석 결과를 조회하는 역할이므로 생성 모델 키를 보유하지 않는다.
# 생성 모델 키는 agent/.env 에 둔다.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-or-secret-key

# FastAPI 에이전트 주소. 비우면 http://localhost:8000 을 사용한다.
AGENT_URL=http://localhost:8000

# Express 가 열 포트. 배포 플랫폼(Render 등)은 PORT 를 직접 주입하므로 값을 고정하지
# 않는다. 로컬에서만 쓰고, 비우면 4000 을 사용한다.
PORT=4000

# 교차 출처 요청을 허용할 화면 주소. 쉼표로 구분한 목록이며 scheme 을 포함한다
# (예: https://careersignal.vercel.app,https://careersignal-git-preview.vercel.app).
# 끝의 `/` 는 있어도 없어도 된다. src/cors.js 가 떼어 낸다.
#
# 비우면 개발 기본값 http://localhost:5173 · http://127.0.0.1:5173 만 허용한다.
# `*` 는 기본값이 아니며 값으로도 두지 않는다. 목록에 없는 출처에는 응답에
# Access-Control-Allow-Origin 을 붙이지 않고, 요청 자체를 막지도 않는다.
#
# 로컬 개발은 Vite 프록시가 같은 출처로 만들어 주므로 이 값이 없어도 동작한다.
# 배포에서는 Vercel 화면의 출처를 넣어야 브라우저가 응답을 읽는다.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------- 배포 (Phase 23-1)
# 주소는 환경마다 다르다. 저장소에는 이름만 두고 값은 배포 플랫폼의 환경변수로 넣는다.
#
#   로컬     PORT=4000 · AGENT_URL=http://localhost:8000 · ALLOWED_ORIGINS 는 비움
#            React 는 product/vite.config.js 의 proxy 로 /api 를 4000 으로 넘긴다.
#   배포     PORT 는 Render 가 주입 · AGENT_URL 은 FastAPI 서비스의 URL(scheme 포함)
#            ALLOWED_ORIGINS 는 Vercel 화면의 출처 · React 는 VITE_API_BASE 로 이
#            서비스를 가리킨다. 두 값은 짝이며 한쪽만 넣으면 화면이 응답을 못 읽는다.
#
# 서비스 정의는 server/render.yaml, FastAPI 실행 명령은 agent/Procfile 에 있다.
# React 쪽 VITE_API_BASE 의 설명은 product/.env.example 에 있고, 값은 Vercel
# 대시보드에서 환경(Production·Preview)별로 넣는다. 빈 값이면 같은 출처를 쓴다.
