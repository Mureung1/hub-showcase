# API 서버 환경변수 예시. 로컬에서는 이 파일을 .env 로 복사해서 쓴다.
# 배포(Render)에서는 파일 대신 대시보드의 Environment 탭에 같은 키를 넣는다.

# 서버 포트. Render 는 자동으로 넣어주므로 배포에서는 설정하지 않는다.
PORT=3001

# 추가로 허용할 프론트엔드 주소(CORS). 여러 개면 쉼표로 구분한다.
#
# 이 서비스의 배포 주소(what-first / exam-priority-calculator)는 server/src/index.js 에
# 이미 들어 있어서 여기 안 적어도 허용된다. 이 값은 그 밖의 주소를 열어줄 때만 쓴다.
#
# 로컬 개발에서 비워두면 모든 오리진을 허용한다.
# (배포에서는 NODE_ENV=production 이라 비워둬도 목록만 허용한다.)
CORS_ORIGIN=

# SQLite 파일 경로. 비워두면 server/data/app.db 를 쓴다.
# Render 무료 플랜은 디스크가 배포마다 초기화되므로 데이터를 유지하려면
# 유료 디스크를 붙이거나 Supabase(Postgres)로 옮겨야 한다. → docs/deployment.md
DB_PATH=
