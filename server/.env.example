SESSION_SECRET=change-me-in-local-env
OPENAI_API_KEY=

# Postgres 연결 문자열 (Neon·Supabase 등에서 발급)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# 로컬 Postgres처럼 SSL이 없으면 false (관리형 DB는 비워두면 SSL 사용)
DATABASE_SSL=true

# /v1/chat 계정별 요청 한도 (미설정 시 기본값: 분당 3회, 시간당 10회)
CHAT_RATE_PER_MINUTE=3
CHAT_RATE_PER_HOUR=10
