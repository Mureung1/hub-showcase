# server/.env 로 복사해서 사용 (실제 .env는 커밋 금지)
PORT=4000
DATABASE_URL=postgresql://rbgus:1234@localhost:5432/hub
# 만료 처리 주기(ms). 기본 60000
EXPIRY_INTERVAL_MS=60000

# FCM 서비스 계정 키 경로 (비밀 — 레포 밖에 두고 경로만 지정)
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
# 미설정 시 푸시는 비활성되고 인앱 알림만 동작한다
FIREBASE_SERVICE_ACCOUNT_PATH=
