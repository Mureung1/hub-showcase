# Supabase 프로젝트 설정 → Supabase 대시보드 > Project Settings > Database > Connection string 에서 확인
# Transaction pooler (포트 6543, pgbouncer) — 서버리스 함수용, 커넥션 고갈 방지
DATABASE_URL=

# Session/Direct connection (포트 5432, non-pooled) — 마이그레이션(prisma migrate) 실행용
DIRECT_URL=

# Express dev 서버 포트 (vite.config.js의 proxy 대상과 일치해야 함)
PORT=3001

# Web Push VAPID 키 쌍 — `npx web-push generate-vapid-keys`로 발급해 아래 두 값에 채운다.
# public key는 프론트에도 노출되지만(루트 .env의 VITE_VAPID_PUBLIC_KEY와 동일 값),
# private key는 서버 전용이라 절대 프론트/VITE_ 쪽에 두지 않는다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# web-push의 setVapidDetails()가 요구하는 연락처(mailto: 또는 https: URL) — 발송 실패 시
# 푸시 서비스(FCM 등)가 이 값으로 연락한다.
VAPID_SUBJECT=mailto:your-email@example.com
