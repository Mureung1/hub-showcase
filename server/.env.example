# server/.env 로 복사해서 실제 값을 채운다. server/.env는 .gitignore에 포함되어 커밋되지 않는다.

# 서버 포트
PORT=4000

# FE 개발 서버 주소 (CORS 허용 origin). 콤마로 여러 개 지정 가능(Vite가 5173이 사용 중이면
# 5174 등으로 자동 넘어가는 경우 대비). 배포 후에는 실제 FE 배포 URL로 교체.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Supabase (service_role 키 — 서버 전용, 브라우저에 절대 노출 금지)
SUPABASE_URL=
SUPABASE_KEY=

# Meilisearch
MEILISEARCH_HOST=
MEILISEARCH_ADMIN_KEY=
MEILISEARCH_SEARCH_KEY=

# AI 챗봇 연동 API (아직 어떤 서비스를 쓸지 미정 — docs/checklist.md "동료 피드백 반영" 항목 참고)
LLM_API_KEY=

# Claude API (구조화된 출력) — 시나리오 초안 생성 스크립트(generateScenarios.js)용
ANTHROPIC_API_KEY=