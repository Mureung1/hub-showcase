// Supabase(Postgres) 연결 설정.
// 모델(tasks/avoidance_reasons/task_events/feedbacks)은 다음 단계에서 추가한다 — 여기서는 연결 설정만.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Task {
  id          String   @id @default(cuid())
  title       String
  type        String   // 리포트/글쓰기, 문제풀이/암기, 발표/PT 준비, 코딩 실습,
                        // 시험공부, 프로젝트, 조별과제, 개인공부, 기타 (문자열, enum 아님)
  startTime   DateTime // 시작 예정 시각 (UTC ISO)
  deadline    DateTime // 마감 D-day
  status      String   // waiting | active | done
  skipCount   Int      @default(0)
  level       Int      @default(0) // Lv0~4
  createdAt   DateTime @default(now())

  events           TaskEvent[]
  avoidanceReasons AvoidanceReason[]

  @@map("tasks")
}

model AvoidanceReason {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id])
  reason     String   // overwhelm | dislike | temptation | custom
  customText String?  // reason = custom 일 때만
  level      Int?     // null = 최초 등록, 1 or 3 = 재확인 시점
  createdAt  DateTime @default(now())

  @@index([taskId, createdAt])
  @@map("avoidance_reasons")
}

model TaskEvent {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id])
  eventType  String   // notification_sent | level_up | done | stopped
  occurredAt DateTime @default(now())

  @@index([taskId, occurredAt])
  @@map("task_events")
}

// 앱 전역 스트릭 값을 담는 단일 행 테이블. task별 값이 아니라 세션(앱) 전역 값이므로
// Task 테이블에 컬럼을 두지 않고 별도 싱글턴 테이블로 분리한다.
model AppState {
  id     String @id @default("singleton")
  streak Int    @default(0)

  @@map("app_state")
}

// 브라우저 Push 구독 정보(#32). 이 프로젝트엔 로그인/인증이 없는 단일 사용자
// 프로토타입이라 userId 컬럼은 두지 않는다 — Web Push 스펙상 endpoint가 브라우저/
// 디바이스별로 고유하므로 이걸 유일 키로 삼아 "같은 endpoint면 갱신"을 표현한다.
// 다중 사용자를 도입하게 되면 그때 별도 마이그레이션으로 userId를 추가한다.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_subscriptions")
}