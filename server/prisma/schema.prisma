generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String       @id @default(uuid())
  email               String       @unique
  passwordHash        String
  name                String
  nickname            String
  preferredCategory   String?
  onboardingCompleted Boolean      @default(false)
  createdAt           DateTime     @default(now())
  records             Record[]
  roomMembers         RoomMember[]
  challenges          Challenge[]

  @@map("users")
}

model Challenge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      String
  topic     String
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("challenges")
}

model Record {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      String
  imageUrl  String
  memo      String
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("records")
}

model Room {
  id         String       @id @default(uuid())
  name       String
  inviteCode String       @unique
  createdAt  DateTime     @default(now())
  members    RoomMember[]

  @@map("rooms")
}

model RoomMember {
  id       String   @id @default(uuid())
  roomId   String
  room     Room     @relation(fields: [roomId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
  @@map("room_members")
}
