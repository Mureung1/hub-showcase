{
  "name": "cv2pf",
  "private": true,
  "version": "0.2.0",
  "description": "CV2PF — CV를 업로드하고 DESIGN.md 테마를 고르면 독립 실행형 포트폴리오 HTML을 만들어 주는 웹앱 (client: React/Vite · server: Express)",
  "workspaces": ["client", "server"],
  "engines": {
    "node": ">=18.16"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace @cv2pf/client",
    "dev:server": "npm run dev --workspace @cv2pf/server",
    "build": "npm run build --workspace @cv2pf/client",
    "start": "npm run start --workspace @cv2pf/server",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "prettier": "^3.3.3"
  }
}
