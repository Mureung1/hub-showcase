# CV2PF 환경변수 예시 — 실제 값은 server/.env 에 두고 절대 커밋하지 않는다.
# (.env* 는 .gitignore 로 제외됨)

# --- 서버 (Express) ---
# Claude Messages API 키. 반드시 서버에서만 사용한다(브라우저 노출 금지).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# 생성에 사용할 모델 (예: claude-sonnet-5 | claude-opus-4-8)
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# API 서버 포트
PORT=4000
# CORS 허용 오리진 (Vite 개발 서버)
CLIENT_ORIGIN=http://localhost:5173

# Supabase Data API. secret key는 서버에서만 사용하고 브라우저에 노출하지 않는다.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# --- 클라이언트 (Vite) ---
# 개발 중 /api 프록시 대상. 비우면 http://localhost:4000 사용.
VITE_API_PROXY=http://localhost:4000
# true면 Express/Supabase 없이 브라우저 메모리 mock으로 저장·조회 흐름을 확인한다.
VITE_USE_MOCK_PORTFOLIOS=false
