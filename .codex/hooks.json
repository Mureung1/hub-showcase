{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/docs/codex-stop-reminder.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; node (Join-Path $root 'tools/docs/codex-stop-reminder.mjs')\"",
            "timeout": 10,
            "statusMessage": "Checking final-work reminder"
          }
        ]
      }
    ]
  }
}
