  title: string
  category: string
  receptionStartDate: string
  receptionEndDate: string
  eventStartDate?: string
  eventEndDate?: string
  sourceUrl: string
  parseStatus: string
  isEligible: boolean
  matchScore: number
  isScraped: boolean
  smartScore?: {
    score: number
    reason: string
    isRecommended: boolean
    conflictLevel: 'high' | 'medium' | 'low' | 'none'
  }
  eligibility: {
    majors: string[]
    regions: string[]
    grades: number[]
    enrollmentStatuses: string[]
