                  style={{
                    padding: '8px 20px',
                    backgroundColor: '#2563eb',
                    color: '#fff',
                    borderRadius: '6px',
                    border: 'none',
                    cursor: 'pointer',
                    fontSize: '13px',
                    fontWeight: 600,
