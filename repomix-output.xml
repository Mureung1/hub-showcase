  fetch: async () => {
    return apiCall<UserProfile>('/profile', {
      method: 'GET',
    })
  },

  update: async (data: Partial<Record<string, any>>) => {
    return apiCall<UserProfile>('/profile', {
      method: 'PATCH',
      body: JSON.stringify(data),
