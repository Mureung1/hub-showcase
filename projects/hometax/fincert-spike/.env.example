# 1단계(explore-login.mjs)는 이 값들이 전혀 필요 없음 — 로그인 화면 구조 파악만 함
# 2단계(login-test.mjs)에서만 사용 예정. 절대 커밋하지 말 것 (.gitignore 처리됨)

# 손택스/홈택스 자동연결 설정 후 사용하는 간편비밀번호 (6자리 PIN 등)
HOMETAX_FINCERT_PIN=

# 로그인 식별에 필요할 수 있는 값 (실제 화면 확인 후 필요 여부 결정)
HOMETAX_BUSINESS_ID=

# refund-email-send.mjs 에서 사용 — 환급금 조회 결과를 실제로 이메일 발송하는 테스트용.
# 발신 Gmail 계정에서 2단계 인증을 켠 뒤 "앱 비밀번호"를 발급받아 넣을 것 (일반 로그인 비밀번호 아님).
GMAIL_SENDER_ADDRESS=
GMAIL_APP_PASSWORD=

# 수신자 주소 — 코드에 하드코딩하지 않고 여기로 분리
REFUND_EMAIL_RECIPIENT=
