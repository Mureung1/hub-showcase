# 이 파일을 복사해 .env를 만들지 말 것 — 이 프로젝트는 .env 자동 로드를 하지 않는다.
# 값은 실행 셸에서 직접 주입한다 (PowerShell 예시):
#   $env:TAXWIZ_DATABASE_URL = "postgresql://..."
#   python -m taxengine.api.main

# Supabase(Postgres) 접속 URL — 설정하면 API/CLI가 SQLite 대신 이 DB를 쓴다.
# ⚠️ 반드시 Session Pooler(IPv4, 포트 5432) 주소를 쓸 것 — Direct 연결(db.<ref>.supabase.co)은
#    무료 티어에서 IPv6 전용이라 Windows 가정용 네트워크에서 접속이 안 될 수 있다.
# TAXWIZ_DATABASE_URL=postgresql://postgres.<project-ref>:<비밀번호>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# SQLite 파일 경로 — TAXWIZ_DATABASE_URL이 없을 때만 사용 (기본값 그대로면 지정 불필요)
# TAXWIZ_DB=taxengine/db/taxwiz.db

# ── 인증 (taxengine/api/auth.py) ──────────────────────────────────────
# Supabase 프로젝트 URL — JWT를 비대칭키(JWKS)로 검증 (2026년 신규 프로젝트 기본)
# SUPABASE_URL=https://<project-ref>.supabase.co
# 레거시 HS256 프로젝트일 때만: 대시보드 Settings→JWT Keys의 Legacy JWT Secret
# SUPABASE_JWT_SECRET=<jwt-secret>

# FE dev 서버 origin — CORS 허용 대상 (기본 http://localhost:5173)
# TAXWIZ_FRONTEND_ORIGIN=http://localhost:5173
