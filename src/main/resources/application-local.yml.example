# 이 파일을 application-local.yml로 복사해서 쓰세요.
# application-local.yml은 .gitignore에 있으므로 커밋되지 않습니다.
#
#   cp application-local.yml.example application-local.yml
#
# 또는 환경변수로 주입:
#   export DB_URL=jdbc:mysql://localhost:3306/lineup
#   export DB_USERNAME=root
#   export DB_PASSWORD=여기에_본인_비밀번호

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/lineup?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root
    password: CHANGE_ME
