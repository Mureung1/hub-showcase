generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReceiptSourceType {
  PAPER_RECEIPT
  ORDER_SCREEN
}

enum ExpenseInputType {
  PAPER_RECEIPT
  ORDER_SCREEN
  MANUAL
}

enum Category {
  DELIVERY
  CONVENIENCE_STORE
  CAFE
  MEAL_KIT
  MART
  CAMPUS_MEAL
  SHOPPING
  OTHER
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  nickname      String
  createdAt     DateTime       @default(now())
  receipts      Receipt[]
  expenses      Expense[]
  subscriptions Subscription[]
}

model Receipt {
  id         Int               @id @default(autoincrement())
  user       User              @relation(fields: [userId], references: [id])
  userId     Int
  imageUrl   String
  ocrRawJson String?
  sourceType ReceiptSourceType
  uploadedAt DateTime          @default(now())
  expenses   Expense[]
}

model Expense {
  id        Int              @id @default(autoincrement())
  user      User             @relation(fields: [userId], references: [id])
  userId    Int
  receipt   Receipt?         @relation(fields: [receiptId], references: [id])
  receiptId Int?
  storeName String?
  itemName  String?
  amount    Int
  category  Category
  spentAt   DateTime
  inputType ExpenseInputType
  createdAt DateTime         @default(now())
}

model Subscription {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  serviceName String
  amount      Int
  billingDay  Int
  createdAt   DateTime @default(now())
}