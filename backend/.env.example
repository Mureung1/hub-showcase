# Express Server Config
PORT=3000

# Supabase API Config (For @supabase/supabase-js)
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# PostgreSQL Connection String (For Prisma or direct PG client)
# 1. 일반 서비스 동작용 (Transaction-mode pooler: port 6543)
DATABASE_URL=YOUR_TRANSACTION_MODE_POOLER_URL

# 2. 마이그레이션용 (Session-mode or Direct Connection: port 5432)
DIRECT_URL=YOUR_SESSION_MODE_OR_DIRECT_CONNECTION_URL

GEMINI_API_KEY=Gemini API Key
GEMINI_MODEL=gemini-flash-latest
# 429(쿼터 초과)/503(과부하) 시 순서대로 자동 폴백할 모델 목록(콤마 구분)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# 공개 URL 배포 시 비용 방어용. /analyze, /refine의 하루 총 호출 상한(기본 50).
GEMINI_DAILY_QUOTA=50