PORT=4000
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# data.go.kr 기후에너지환경부_분리배출 정보조회 서비스(15156866) 인증키 — Decoding(일반) 키를 사용
PUBLIC_DATA_SERVICE_KEY=[YOUR-PUBLIC-DATA-SERVICE-KEY]
# Gemini API 키 (Vision 인식 + LLM 설명 생성 공용) — 설정하지 않으면 mock 클라이언트가 자동으로 사용됨
# 무료 티어 사용 — gemini-2.5-flash가 일일 한도(RPD)에 걸리면 gemini-2.5-flash-lite로 자동 폴백 (geminiClient.ts 참고)
GEMINI_API_KEY=[YOUR-GEMINI-API-KEY]