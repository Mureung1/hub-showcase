PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Supabase Postgres 연결 문자열 (값은 Supabase 프로젝트 설정 > Database에서 발급)
DATABASE_URL=   # 런타임 쿼리용 (Connection pooler, 포트 6543, ?pgbouncer=true)
DIRECT_URL=     # 마이그레이션 전용 직결 연결 (포트 5432)

# Supabase 프로젝트 URL (프론트 .env의 VITE_SUPABASE_URL과 동일한 값. JWKS 공개키 조회에 사용)
SUPABASE_URL=

# (더 이상 인증 검증에 쓰이지 않음 — 프로젝트가 비대칭 서명 키(ES256)로 전환되어 있어
#  고정 시크릿 방식 검증은 항상 실패한다. SUPABASE_URL 기반 JWKS 검증으로 교체함.)
SUPABASE_JWT_SECRET=

# AI 매칭(편지 태깅·추천 이유 생성)용 Gemini API 키 (값은 Google AI Studio에서 발급, 비공개)
GEMINI_API_KEY=

# 기본값은 mock(true)이다 — 이 줄을 아예 지워도 mock으로 동작한다(안전 기본값).
# 실제 Gemini를 부르려면 GEMINI_API_KEY를 채우고 아래처럼 명시적으로 false로 바꿔야 한다.
AI_MOCK=true
# AI_MOCK=false

# Gemini 무료 티어 일일 호출 한도 보호용 상한 (초과 시 새 추천 생성만 중단, 캐시 서빙은 계속)
DAILY_CALL_CAP=200

# 관리자 API(/api/admin/*) 접근 허용 목록. Supabase 사용자 UUID를 쉼표로 구분해서 넣는다.
# (Supabase 대시보드 Authentication > Users에서 본인 계정의 UID 확인 가능)
ADMIN_USER_IDS=

# 편지를 보내고 몇 시간 뒤에 추천을 받을 수 있는지. 기본 24(실서비스 기준).
# 매칭 품질 테스트/시연 중에는 0으로 두면 보내자마자 바로 추천을 받을 수 있다.
# 배포 전에는 반드시 24로 되돌릴 것.
SOURCE_READY_DELAY_HOURS=24
