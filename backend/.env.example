PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase 프로젝트 설정(Settings > API)에서 확인
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# service_role 키는 RLS를 우회한다. 절대 프론트엔드나 공개 저장소에 노출하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# Market data providers
# NAVER_API_MODE=DEVELOPERS uses X-Naver-Client-Id / X-Naver-Client-Secret.
# NAVER_API_MODE=API_HUB uses NAVER API HUB headers.
NAVER_API_MODE=API_HUB
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_API_HUB_KEY=

FMP_API_KEY=

OPEN_DART_API_KEY=

FRED_API_KEY=

TOSS_INVEST_CLIENT_ID=
TOSS_INVEST_CLIENT_SECRET=
