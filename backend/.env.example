PORT=4000

# Server-side only — never expose this to the client bundle.
# AI 자동 피드백용 Google Gemini 키 (aistudio.google.com/apikey 에서 무료 발급)
GEMINI_API_KEY=

# AI 자동 피드백에 쓸 모델(선택). 미설정 시 gemini-2.5-flash.
# AI_FEEDBACK_MODEL=gemini-2.5-flash
# AI 예시 생성 스크립트용 모델·지연(선택).
# AI_EXAMPLE_MODEL=gemini-2.5-flash
# EXAMPLE_DELAY_MS=4000

# RAWG 게임 검색 API 키 (server-side only). rawg.io/apidocs 에서 무료 발급.
# 에디터의 "대상 게임" 자동완성(/api/games/search)에 쓴다.
RAWG_API_KEY=

# Supabase — server-side only. frontend는 backend REST를 통해서만 DB에 접근한다.
# SUPABASE_URL: 프로젝트 URL (https://xxxx.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: service_role 키 (절대 frontend 번들에 넣지 말 것)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
