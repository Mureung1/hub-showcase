SUPABASE_URL=
SUPABASE_KEY=
MAFRA_API_KEY=

# KAMIS(농산물유통정보) Open API — 미설정 시 GET /api/prices는 정적 폴백 값을 반환한다.
# 발급: https://www.kamis.or.kr (Open-API 이용안내 > 신청)
KAMIS_API_KEY=
KAMIS_CERT_ID=

# Naver Clova OCR(General) — 미설정 시 영수증 촬영은 기존 데모 Mock으로 폴백한다.
# 발급: NAVER CLOUD PLATFORM 콘솔 > AI·Application Service > CLOVA OCR
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET_KEY=

# Web Push VAPID 키 — 유통기한 임박 서버 푸시 알림에 사용. 미설정 시 서버가 부팅 시 1회성으로
# 자동 생성해 로그에 출력한다(재시작마다 바뀌므로 실제 운영에선 고정값을 넣을 것).
# 생성: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
