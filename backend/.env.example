# Express Server Config
PORT=3000

# Supabase API Config (For @supabase/supabase-js)
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# PostgreSQL Connection String (For Prisma or direct PG client)
# 1. 일반 서비스 동작용 (Transaction-mode pooler: port 6543)
DATABASE_URL=YOUR_TRANSACTION_MODE_POOLER_URL

# 2. 마이그레이션용 (Session-mode or Direct Connection: port 5432)
DIRECT_URL=YOUR_SESSION_MODE_OR_DIRECT_CONNECTION_URL
