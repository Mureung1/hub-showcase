# 서버 포트
PORT=3000

# CORS 허용 오리진 (프론트 개발 서버)
CORS_ORIGIN=http://localhost:5173

# Supabase PostgreSQL 연결 문자열 (이슈 #4에서 사용)
DATABASE_URL=

# GitHub Personal Access Token (이슈 #5에서 사용)
# 필요 스코프(classic): public_repo, read:user, read:org (소속 조직 판별 — 기여 이력 분류에 사용)
GITHUB_TOKEN=

# Google Gemini API 키 (이슈 #6, LLM 이슈 분석에 사용)
# https://aistudio.google.com/apikey 에서 무료 티어로 발급. 없으면 이슈 분석은 조용히 null로 폴백된다
GEMINI_API_KEY=
