// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// 1. users - 사용자 기본 정보
// ==========================================
model User {
  userId       BigInt   @id @default(autoincrement()) @map("user_id")
  schoolEmail  String   @unique @map("school_email") @db.VarChar(100)
  username     String   @unique @db.VarChar(50)
  isVerified   Boolean  @default(false) @map("is_verified")
  passwordHash String   @map("password_hash") @db.VarChar(255)
  nickname     String   @db.VarChar(50)
  name         String   @db.VarChar(50)
  gender       String   @db.VarChar(10)
  birthYear    Int      @map("birth_year")
  schoolName   String   @map("school_name") @db.VarChar(100)
  inviteCode   String?  @unique @map("invite_code") @db.VarChar(50)
  preferredTeamSize Int? @map("preferred_team_size")
  createdAt    DateTime @default(now()) @map("created_at")

  // 관계
  hobbyTestResult   HobbyTestResult?
  personalityTests  PersonalityTest[]
  roommateProfile   RoommateProfile?
  ledTeams          DatingTeam[]        @relation("TeamLeader")
  teamMemberships   DatingTeamMember[]
  chatMessages      ChatMessage[]
  reportsMade       Report[]            @relation("Reporter")
  reportsReceived   Report[]            @relation("ReportTarget")

  candidateChatRoomsAsUser1 CandidateChatRoom[]    @relation("CandidateChatRoomUser1")
  candidateChatRoomsAsUser2 CandidateChatRoom[]    @relation("CandidateChatRoomUser2")
  candidateChatMessagesSent CandidateChatMessage[] @relation("CandidateChatMessageSender")

  teamInvitesSent     TeamInvite[] @relation("TeamInviteFrom")
  teamInvitesReceived TeamInvite[] @relation("TeamInviteTo")

  @@map("users")
}

// ==========================================
// 2. hobby_test_results - 취미 발견 테스트 결과
// ==========================================
model HobbyTestResult {
  resultId    BigInt   @id @default(autoincrement()) @map("result_id")
  userId      BigInt   @unique @map("user_id")
  hobbyTags   Json     @map("hobby_tags")
  rawAnswers  Json     @map("raw_answers")
  scoreSummary Json?   @map("score_summary")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@map("hobby_test_results")
}

// ==========================================
// 3. personality_tests - 연애/생활 성향 테스트 결과
// ==========================================
enum TestType {
  dating
  lifestyle
}

model PersonalityTest {
  testId        BigInt   @id @default(autoincrement()) @map("test_id")
  userId        BigInt   @map("user_id")
  testType      TestType @map("test_type")
  answers       Json
  scoreSummary  Json     @map("score_summary")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@map("personality_tests")
}

// ==========================================
// 4. roommate_profiles - 룸메이트 매칭 조건
// ==========================================
enum RoommateType {
  friend
  business
}

model RoommateProfile {
  profileId    BigInt       @id @default(autoincrement()) @map("profile_id")
  userId       BigInt       @unique @map("user_id")
  roommateType RoommateType @map("roommate_type")
  createdAt    DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@map("roommate_profiles")
}

// ==========================================
// 5. dating_teams / dating_team_members - 과팅 팀
// ==========================================
enum TeamStatus {
  recruiting
  matched
  closed
  // 매칭 신청(MatchRequest)이 수락되어 이성 매칭이 실제로 성사된 상태.
  // matched(이성 매칭 후보로 노출 가능)와 달리, 이 상태가 되면 더 이상 후보 리스트에 노출되면 안 된다.
  confirmed
}

model DatingTeam {
  teamId    BigInt     @id @default(autoincrement()) @map("team_id")
  leaderId  BigInt     @map("leader_id")
  gender    String     @db.VarChar(10)
  teamSize  Int        @map("team_size")
  status    TeamStatus @default(recruiting)
  createdAt DateTime   @default(now()) @map("created_at")

  leader  User               @relation("TeamLeader", fields: [leaderId], references: [userId])
  members DatingTeamMember[]
  invites TeamInvite[]

  @@map("dating_teams")
}

model DatingTeamMember {
  teamId BigInt @map("team_id")
  userId BigInt @map("user_id")

  team DatingTeam @relation(fields: [teamId], references: [teamId])
  user User       @relation(fields: [userId], references: [userId])

  @@id([teamId, userId])
  @@map("dating_team_members")
}

// ==========================================
// 6. matches - 매칭 결과
// ==========================================
enum MatchType {
  roommate
  dating_same
  dating_opposite
}

enum MatchStatus {
  proposed
  confirmed
  rejected
}

model Match {
  matchId          BigInt      @id @default(autoincrement()) @map("match_id")
  matchType        MatchType   @map("match_type")
  partyAId         BigInt      @map("party_a_id")
  partyBId         BigInt      @map("party_b_id")
  similarityScore  Float       @map("similarity_score")
  status           MatchStatus @default(proposed)
  matchedAt        DateTime    @default(now()) @map("matched_at")

  chatRoom ChatRoom?

  @@map("matches")
}

// ==========================================
// 7. chat_rooms / chat_messages - 채팅
// ==========================================
model ChatRoom {
  chatRoomId BigInt   @id @default(autoincrement()) @map("chat_room_id")
  matchId    BigInt   @unique @map("match_id")
  createdAt  DateTime @default(now()) @map("created_at")

  match    Match         @relation(fields: [matchId], references: [matchId])
  messages ChatMessage[]

  @@map("chat_rooms")
}

model ChatMessage {
  messageId  BigInt   @id @default(autoincrement()) @map("message_id")
  chatRoomId BigInt   @map("chat_room_id")
  senderId   BigInt   @map("sender_id")
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [chatRoomId])
  sender   User     @relation(fields: [senderId], references: [userId])

  @@map("chat_messages")
}

// ==========================================
// 8. reports - 신고
// ==========================================
enum ReportStatus {
  pending
  reviewed
  resolved
}

model Report {
  reportId   BigInt       @id @default(autoincrement()) @map("report_id")
  reporterId BigInt       @map("reporter_id")
  targetId   BigInt       @map("target_id")
  reason     String       @db.VarChar(255)
  status     ReportStatus @default(pending)
  createdAt  DateTime     @default(now()) @map("created_at")

  reporter User @relation("Reporter", fields: [reporterId], references: [userId])
  target   User @relation("ReportTarget", fields: [targetId], references: [userId])

  @@map("reports")
}

// ==========================================
// 9. candidate_chat_rooms / candidate_chat_messages
//    동성 매칭 후보끼리 매칭 확정 전 초대 코드 교환용 임시 채팅
//    (매칭 확정 후 채팅은 기존 matches 기반 ChatRoom/ChatMessage 그대로 사용)
// ==========================================
model CandidateChatRoom {
  id        BigInt   @id @default(autoincrement())
  // user1Id에는 항상 둘 중 작은 userId를 저장한다 (중복 방 생성 방지를 위한 정렬 규칙).
  // DB 레벨에서 강제하지 않고 애플리케이션 로직에서 보장한다.
  user1Id   BigInt   @map("user1_id")
  user2Id   BigInt   @map("user2_id")
  createdAt DateTime @default(now()) @map("created_at")
  // 각 유저가 이 채팅방의 메시지를 마지막으로 조회한 시각. null이면 한 번도 읽지 않은 상태.
  user1LastReadAt DateTime? @map("user1_last_read_at")
  user2LastReadAt DateTime? @map("user2_last_read_at")

  user1    User                   @relation("CandidateChatRoomUser1", fields: [user1Id], references: [userId])
  user2    User                   @relation("CandidateChatRoomUser2", fields: [user2Id], references: [userId])
  messages CandidateChatMessage[]

  @@unique([user1Id, user2Id])
  @@map("candidate_chat_rooms")
}

model CandidateChatMessage {
  id         BigInt   @id @default(autoincrement())
  chatRoomId BigInt   @map("chat_room_id")
  senderId   BigInt   @map("sender_id")
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  chatRoom CandidateChatRoom @relation(fields: [chatRoomId], references: [id])
  sender   User              @relation("CandidateChatMessageSender", fields: [senderId], references: [userId])

  @@map("candidate_chat_messages")
}

// ==========================================
// 10. team_invites - 과팅 팀 초대 (코드로 팀원 초대)
// ==========================================
enum InviteStatus {
  pending
  accepted
  rejected
}

model TeamInvite {
  id         BigInt       @id @default(autoincrement())
  fromUserId BigInt       @map("from_user_id")
  toUserId   BigInt       @map("to_user_id")
  // 초대 시점엔 비어있고, 수락 시점에 채워짐
  teamId     BigInt?      @map("team_id")
  status     InviteStatus @default(pending)
  createdAt  DateTime     @default(now()) @map("created_at")

  fromUser User        @relation("TeamInviteFrom", fields: [fromUserId], references: [userId])
  toUser   User        @relation("TeamInviteTo", fields: [toUserId], references: [userId])
  team     DatingTeam? @relation(fields: [teamId], references: [teamId])

  @@map("team_invites")
}

// ==========================================
// 11. match_requests - 과팅 이성 팀 매칭 신청 (관심 보내기)
//     matches 테이블은 궁합 계산 기록용이라 신청 방향성을 담을 수 없어 별도 테이블로 분리함.
//     Match 모델과 동일하게 fromTeamId/toTeamId는 relation 없이 plain BigInt로 둔다.
// ==========================================
enum MatchRequestStatus {
  pending
  accepted
  rejected
}

model MatchRequest {
  requestId       BigInt             @id @default(autoincrement()) @map("request_id")
  fromTeamId      BigInt             @map("from_team_id")
  toTeamId        BigInt             @map("to_team_id")
  similarityScore Float              @map("similarity_score")
  status          MatchRequestStatus @default(pending)
  createdAt       DateTime           @default(now()) @map("created_at")

  @@unique([fromTeamId, toTeamId])
  @@map("match_requests")
}

// ==========================================
// 12. team_match_chat_rooms / team_match_chat_room_members / team_match_chat_messages
//     매칭 신청(MatchRequest)이 수락되어 성사된 두 팀의 전체 팀원이 함께 참여하는 그룹 채팅.
//     CandidateChatRoom(동성 후보 1:1 초대코드 교환용)과는 용도가 달라 별도 테이블로 둔다.
// ==========================================
model TeamMatchChatRoom {
  id BigInt @id @default(autoincrement())
  // 이 채팅방을 만든 매칭 신청(MatchRequest). MatchRequest의 fromTeamId/toTeamId와 동일하게
  // relation 없이 plain BigInt로 둔다 (MatchRequest 모델은 이번 작업에서 건드리지 않음).
  matchRequestId BigInt   @unique @map("match_request_id")
  createdAt      DateTime @default(now()) @map("created_at")

  members  TeamMatchChatRoomMember[]
  messages TeamMatchChatMessage[]

  @@map("team_match_chat_rooms")
}

model TeamMatchChatRoomMember {
  id         BigInt @id @default(autoincrement())
  chatRoomId BigInt @map("chat_room_id")
  // 참여자(매칭된 두 팀의 팀원). User 모델은 이번 작업에서 건드리지 않으므로 relation 없이 plain BigInt로 둔다.
  userId     BigInt @map("user_id")
  // 이 유저가 이 채팅방의 메시지를 마지막으로 조회한 시각. null이면 한 번도 읽지 않은 상태.
  lastReadAt DateTime? @map("last_read_at")

  chatRoom TeamMatchChatRoom @relation(fields: [chatRoomId], references: [id])

  @@unique([chatRoomId, userId])
  @@map("team_match_chat_room_members")
}

model TeamMatchChatMessage {
  id         BigInt   @id @default(autoincrement())
  chatRoomId BigInt   @map("chat_room_id")
  // 메시지를 보낸 유저. User 모델은 이번 작업에서 건드리지 않으므로 relation 없이 plain BigInt로 둔다.
  senderId   BigInt   @map("sender_id")
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  chatRoom TeamMatchChatRoom @relation(fields: [chatRoomId], references: [id])

  @@map("team_match_chat_messages")
}