generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  username  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedSubscriptions Subscription[]
  partyMemberships   PartyMember[]
  settlementMembers  SettlementMember[]

  @@map("users")
}

model Subscription {
  id                String        @id @default(cuid())
  serviceName       String
  subAmount         Int
  billingDay        Int
  memberCount       Int
  bankName          String
  accountNumber     String
  accountHolderName String?
  ownerId           String
  owner             User          @relation(fields: [ownerId], references: [id])
  members           PartyMember[]
  settlements       Settlement[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("subscriptions")
}

model PartyMember {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  joinedAt       DateTime     @default(now())

  @@unique([subscriptionId, userId])
  @@map("party_members")
}

model Settlement {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  billingMonth   String
  createdAt      DateTime     @default(now())

  members SettlementMember[]

  @@unique([subscriptionId, billingMonth])
  @@map("settlements")
}

model SettlementMember {
  id           String                 @id @default(cuid())
  settlementId String
  settlement   Settlement             @relation(fields: [settlementId], references: [id])
  userId       String
  user         User                   @relation(fields: [userId], references: [id])
  name         String
  amount       Int
  status       SettlementMemberStatus @default(pending)
  doneAt       DateTime?
  reportedAt   DateTime?
  createdAt    DateTime               @default(now())

  @@unique([settlementId, userId])
  @@map("settlement_members")
}

enum SettlementMemberStatus {
  pending
  done
}
