datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  points       Int      @default(1000)
  accuracyRate Float    @default(0.0)
  votes        Vote[]
  createdAt    DateTime @default(now())
}

model Drop {
  id              String     @id @default(uuid())
  title           String
  brand           String?    // Added: Brand info (e.g. Nike, Adidas)
  category        String     // e.g. sneakers, streetwear, tcg, lego
  status          DropStatus @default(UPCOMING)
  retailPrice     Int
  consensusPrice  Int        @default(0)
  marketPrice     Int?
  imageUrl        String?    @db.Text // Added: Product image URL
  kreamProductId  String?    @unique // Added: KREAM product ID
  releaseDate     DateTime?  // Added: Official release date
  releaseDateText String?    // Added: Display date text (e.g. "07/20")
  priceChangeRate Float?     // Added: Price change rate percentage
  volume          Int?       // Added: Transaction volume ranking indicator
  votes           Vote[]
  createdAt       DateTime   @default(now())
}

model Vote {
  id             String        @id @default(uuid())
  user           User          @relation(fields: [userId], references: [id])
  userId         String
  drop           Drop          @relation(fields: [dropId], references: [id])
  dropId         String
  direction      VoteDirection
  predictedPrice Int?          // Added: User's actual predicted target price
  predictionDays Int           @default(7) // Added: Prediction target offset days (e.g. 3, 7)
  createdAt      DateTime      @default(now())

  @@unique([userId, dropId]) // Restrict one vote per user per drop
}

enum DropStatus {
  UPCOMING
  RELEASED
}

enum VoteDirection {
  UP
  DOWN
}
