# ============================================================
#  application.yml 에 추가할 설정
#  실제 값은 전부 환경변수로 주입 — 여기에 값을 적어 커밋하지 마세요.
# ============================================================

jwt:
  secret: ${JWT_SECRET}          # 32바이트 이상. 예: openssl rand -base64 48
  validity-seconds: 3600         # 토큰 유효기간 1시간

lineup:
  client-origin: ${CLIENT_ORIGIN:http://localhost:3000}

spring:
  mail:
    host: smtp.gmail.com
    port: 587
    username: ${MAIL_USERNAME}
    password: ${MAIL_PASSWORD}   # Gmail은 앱 비밀번호 사용
    properties:
      mail.smtp.auth: true
      mail.smtp.starttls.enable: true

---
# ============================================================
#  build.gradle 에 추가할 의존성
# ============================================================
#
# dependencies {
#     implementation 'org.springframework.boot:spring-boot-starter-security'
#     implementation 'org.springframework.boot:spring-boot-starter-validation'
#     implementation 'org.springframework.boot:spring-boot-starter-mail'
#
#     implementation 'io.jsonwebtoken:jjwt-api:0.12.6'
#     runtimeOnly    'io.jsonwebtoken:jjwt-impl:0.12.6'
#     runtimeOnly    'io.jsonwebtoken:jjwt-jackson:0.12.6'
# }
#
# ============================================================
#  메인 애플리케이션 클래스에 추가
# ============================================================
#
# @EnableAsync          ← 메일 비동기 발송에 필요
# @SpringBootApplication
# public class HubApplication { ... }
#
# ============================================================
#  로컬 실행 시 환경변수 (.env 또는 IDE 실행설정)
# ============================================================
#
#   JWT_SECRET=<openssl rand -base64 48 결과>
#   MAIL_USERNAME=<보내는 계정>
#   MAIL_PASSWORD=<앱 비밀번호>
#
#   ⚠️ 이 값들은 절대 커밋하지 마세요.
