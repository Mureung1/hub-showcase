{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/embeddings",
    "bodyPatterns": [{ "contains": "force-rate-limit" }]
  },
  "response": {
    "status": 429,
    "headers": { "Content-Type": "application/json", "Retry-After": "1" },
    "jsonBody": { "error": { "type": "rate_limit_error" } }
  }
}
