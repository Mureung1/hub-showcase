{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attempt.schema.json",
  "title": "Immutable Harness Attempt Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "run_id",
    "phase_id",
    "step_id",
    "number",
    "trigger",
    "status",
    "started_at",
    "ended_at",
    "duration_ms",
    "input_snapshot",
    "invocation",
    "agent_report",
    "changes",
    "observations",
    "diagnosis_assessments",
    "remediation_actions",
    "verification_results",
    "failure_updates",
    "evidence",
    "disposition",
    "integrity_hmac"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 8 },
    "phase_id": { "type": "string", "minLength": 1 },
    "step_id": { "type": "string", "minLength": 1 },
    "number": { "type": "integer", "minimum": 1 },
    "trigger": { "enum": ["initial", "retry", "resume"] },
    "predecessor_attempt_id": { "type": ["string", "null"] },
    "status": { "enum": ["succeeded", "failed", "blocked", "interrupted", "cancelled"] },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "input_snapshot": { "type": "object" },
    "invocation": { "type": "object" },
    "agent_report": { "type": ["object", "null"] },
    "changes": { "type": "object" },
    "observations": { "type": "array", "items": { "type": "object" } },
    "diagnosis_assessments": { "type": "array", "items": { "type": "object" } },
    "remediation_actions": { "type": "array", "items": { "type": "object" } },
    "verification_results": { "type": "array", "items": { "type": "object" } },
    "failure_updates": { "type": "array", "items": { "type": "object" } },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "disposition": { "type": "object" },
    "integrity_hmac": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "extensions": { "type": "object" }
  }
}
