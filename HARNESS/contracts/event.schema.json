{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Harness Append-only Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seq",
    "event_id",
    "run_id",
    "occurred_at",
    "event_type",
    "actor",
    "entity",
    "from_status",
    "to_status",
    "attempt_id",
    "correlation_id",
    "payload",
    "prev_hash",
    "event_hash",
    "integrity_key_id"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 8 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "event_type": { "type": "string", "minLength": 1 },
    "actor": { "enum": ["controller", "verifier", "user", "worker", "deploy-adapter"] },
    "entity": { "type": "object" },
    "from_status": { "type": ["string", "null"] },
    "to_status": { "type": ["string", "null"] },
    "attempt_id": { "type": ["string", "null"] },
    "correlation_id": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" },
    "prev_hash": { "type": ["string", "null"] },
    "event_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "integrity_key_id": { "type": "string", "minLength": 1 }
  }
}
