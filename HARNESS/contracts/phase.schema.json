{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase.schema.json",
  "title": "Harness Phase Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "name",
    "kind",
    "objective",
    "required",
    "depends_on",
    "completion_stage",
    "required_inputs",
    "approval",
    "steps"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "phase_id": { "$ref": "#/$defs/slug" },
    "name": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": ["discovery", "design", "build", "quality", "release", "operations"]
    },
    "objective": { "type": "string", "minLength": 1 },
    "required": { "type": "boolean" },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "completion_stage": { "enum": ["passed", "deployed", "observed"] },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "description", "secret"],
        "properties": {
          "key": { "$ref": "#/$defs/slug" },
          "description": { "type": "string", "minLength": 1 },
          "secret": { "type": "boolean" }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "approval_id", "reason"],
      "properties": {
        "mode": { "enum": ["none", "before_phase"] },
        "approval_id": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^[A-Za-z]:|^[/\\\\]|(^|[/\\\\])\\.\\.([/\\\\]|$)|:)" }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "backoff_seconds", "retryable_categories"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "backoff_seconds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0, "maximum": 3600 }
        },
        "retryable_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["timeout", "network", "rate_limit", "external_service", "worker_failure", "verification"]
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "external_side_effects", "production"],
      "properties": {
        "network": { "type": "boolean" },
        "external_side_effects": { "type": "boolean" },
        "production": { "type": "boolean" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "type", "required"],
      "properties": {
        "check_id": { "$ref": "#/$defs/slug" },
        "type": { "enum": ["path_exists", "content_contains", "json_valid", "command"] },
        "required": { "type": "boolean" },
        "path": { "$ref": "#/$defs/relativePath" },
        "values": { "type": "array", "items": { "type": "string" } },
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "cwd": { "$ref": "#/$defs/relativePath" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "expected_exit_codes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer" }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "name",
        "objective",
        "depends_on",
        "instruction_file",
        "context_files",
        "allowed_paths",
        "required_artifacts",
        "acceptance_checks",
        "retry_policy",
        "permissions"
      ],
      "properties": {
        "step_id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "instruction_file": { "$ref": "#/$defs/relativePath" },
        "context_files": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "required_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "secret_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "acceptance_checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/check" }
        },
        "retry_policy": { "$ref": "#/$defs/retryPolicy" },
        "permissions": { "$ref": "#/$defs/permissions" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "permissions": {
                "properties": { "external_side_effects": { "const": true } },
                "required": ["external_side_effects"]
              }
            }
          },
          "then": {
            "properties": {
              "retry_policy": {
                "properties": {
                  "max_attempts": { "const": 1 },
                  "retryable_categories": { "maxItems": 0 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
