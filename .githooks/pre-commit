#!/bin/sh

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$staged_files" ]; then
  exit 0
fi

file_count="$(printf '%s\n' "$staged_files" | sed '/^$/d' | wc -l | tr -d ' ')"

rename_count="$(git diff --cached --name-status -M | awk '$1 ~ /^R/ { count += 1 } END { print count + 0 }')"
has_arch_run_report="$(printf '%s\n' "$staged_files" | grep -E '^\.harness/runs/.+-ARCH-[0-9]+-.+\.md$' || true)"
structural_migration=false

if [ "$rename_count" -ge 10 ] && [ -n "$has_arch_run_report" ]; then
  structural_migration=true
fi

if [ "$file_count" -gt 10 ] && [ "$structural_migration" != true ]; then
  cat <<EOF
Commit is too large: $file_count staged files.

LocalTwin policy:
  - one feature -> verify -> commit
  - one bug fix -> reproduce/verify -> commit
  - one documentation update -> review -> commit

Split this change into smaller commits.
EOF
  exit 1
fi

areas="$(printf '%s\n' "$staged_files" | awk -F/ '
  /^(package\.json|pnpm-workspace\.yaml|pnpm-lock\.yaml|\.editorconfig|\.env\.example|\.gitignore|\.node-version|\.prettierignore|\.prettierrc\.json)$/ { print "tooling/root"; next }
  /^product\/(package\.json|pnpm-workspace\.yaml|pnpm-lock\.yaml|\.env\.example|\.node-version|vercel\.json)$/ { print "tooling/product"; next }
  /^product\/apps\/web\// { print "apps/web"; next }
  /^product\/apps\/api\// { print "apps/api"; next }
  /^product\/data\// { print "data"; next }
  /^product\/scripts\// { print "product/scripts"; next }
  /^docs\/features\// { print "docs/features"; next }
  /^docs\/development\// { print "docs/development"; next }
  /^docs\/module-notes\// { print "docs/module-notes"; next }
  /^\.githooks\// { print "tooling/hooks"; next }
  /^\.github\// { print "tooling/github"; next }
  NF >= 2 { print $1 "/" $2; next }
  { print $1 }
' | sort -u)"

area_count="$(printf '%s\n' "$areas" | sed '/^$/d' | wc -l | tr -d ' ')"

if [ "$area_count" -gt 3 ] && [ "$structural_migration" != true ]; then
  cat <<EOF
Commit touches too many areas: $area_count areas.

Touched areas:
$areas

LocalTwin policy:
  - keep each commit scoped to one feature, one bug fix, or one document change
  - avoid mixing backend, frontend, data pipeline, 3D pipeline, and docs in one commit

Split this change into smaller commits.
EOF
  exit 1
fi

source_files="$(printf '%s\n' "$staged_files" | grep -E '\.(py|js|jsx|ts|tsx|css|html|sql)$|^(product/(apps|scripts)/|api|app|backend|frontend|web|src|packages)/' | grep -Ev '^(docs/|scripts/check_|scripts/check\.ps1|\.harness/)' || true)"

if [ -n "$source_files" ]; then
  python scripts/check_code_structure.py --root . || exit 1
fi

exit 0
