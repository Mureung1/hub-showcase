#!/bin/sh
# 시크릿 유출 방지 pre-commit 훅 (docs/security-secrets.md).
# 스테이징된 변경에서 API 키·실제 .env·개인키 패턴을 탐지하면 커밋을 막는다.
# 활성화: git config core.hooksPath .githooks  (또는 npm run hooks:install)

fail=0

# 1) 실제 .env 파일이 스테이징됐는지( .env.example 은 허용 ).
staged_files=$(git diff --cached --name-only --diff-filter=AM)
for f in $staged_files; do
  case "$f" in
    *.env.example|*.env.sample) : ;;                 # 예시 파일은 허용
    .env|*/.env|.env.*|*/.env.*)                      # 실제 env는 차단
      echo "✋ 커밋 차단: 실제 env 파일이 포함됨 → $f"
      echo "   .env 계열은 커밋하지 않습니다. .env.example 만 커밋하세요."
      fail=1
      ;;
  esac
done

# 2) 스테이징된 '추가된 줄'에서 시크릿 값 패턴 탐지.
#    .example/.sample 파일과 주석(#)으로 시작하는 플레이스홀더 줄은 제외한다.
added=$(git diff --cached -U0 --diff-filter=AM -- . \
  ':(exclude)*.env.example' ':(exclude)*.env.sample' \
  | grep '^+' | grep -v '^+++')

# 값이 실제로 채워진 키만 잡도록 등호 뒤에 공백 아닌 문자가 오는 경우를 본다.
patterns='
OPENAI_API_KEY[[:space:]]*=[[:space:]]*[^[:space:]#]
GEMINI_API_KEY[[:space:]]*=[[:space:]]*[^[:space:]#]
ANTHROPIC_API_KEY[[:space:]]*=[[:space:]]*[^[:space:]#]
SUPABASE_[A-Z_]*KEY[[:space:]]*=[[:space:]]*[^[:space:]#]
SUPABASE_SERVICE_ROLE[[:space:]]*=[[:space:]]*[^[:space:]#]
sk-[A-Za-z0-9]{20,}
AKIA[0-9A-Z]{16}
-----BEGIN[[:space:]]+[A-Z]*[[:space:]]*PRIVATE KEY-----
eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}\.
'

while IFS= read -r pat; do
  [ -z "$pat" ] && continue
  hit=$(printf '%s\n' "$added" | grep -nE -e "$pat")
  if [ -n "$hit" ]; then
    echo "✋ 커밋 차단: 시크릿으로 보이는 값이 스테이징됨 (패턴: $pat)"
    echo "$hit" | sed 's/^/     /'
    fail=1
  fi
done <<EOF
$patterns
EOF

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "→ 값을 .env(커밋 안 함)로 옮기고, 예시엔 빈 플레이스홀더만 두세요."
  echo "→ 오탐이거나 의도된 예시라면: git commit --no-verify (신중히)."
  exit 1
fi

exit 0
