{
  "name": "@ay-ple/runtime-codex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "generate:codex-types": "tsx scripts/generate-codex-app-server-types.ts",
    "smoke:codex": "tsx src/smoke.ts",
    "test": "NODE_OPTIONS=--conditions=development tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "@ay-ple/runtime-core": "0.0.0",
    "@openai/codex": "0.142.5"
  }
}
