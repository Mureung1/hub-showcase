+def test_overflow_wakes_current_and_future_waiters_with_first_failure() -> None:
+    router = MessageRouter(_RouterLimits(global_bytes=49, aggregate_bytes=49))
+    router.register_turn("turn-1")
+    router.register_login("login-1")
+    response_waiter = router.create_response_waiter("request-1")
+
+    with ThreadPoolExecutor(max_workers=4) as executor:
+        futures = [
+            executor.submit(router.next_turn_notification, "turn-1"),
+            executor.submit(router.next_turn_notification, "turn-1"),
+            executor.submit(router.next_login_notification, "login-1"),
+            executor.submit(router.next_global_notification),
+        ]
+        _wait_for_router_waiters(
+            router,
+            response=1,
+            turn=2,
+            login=1,
+            global_=1,
+        )
+
+        notification = Notification(
+            method="unknown/global",
+            payload=UnknownNotification(params={"text": "é"}),
+        )
+        with pytest.raises(_RouterBufferOverflow) as caught:
+            router.route_notification(notification)
+
+        failure = caught.value
+        assert isinstance(failure, CodexError)
+        assert failure.code == "buffer_overflow"
+        assert response_waiter.get(timeout=1) is failure
+        for future in futures:
+            with pytest.raises(_RouterBufferOverflow) as waiter_failure:
+                future.result(timeout=1)
+            assert waiter_failure.value is failure
+
+    router.fail_all(RuntimeError("later transport failure"))
+    future_reads = [
+        lambda: router.create_response_waiter("request-2"),
+        lambda: router.next_turn_notification("turn-1"),
+        lambda: router.next_login_notification("login-1"),
+        router.next_global_notification,
+    ]
+    for read in future_reads:
+        with pytest.raises(_RouterBufferOverflow) as future_failure:
+            read()
+        assert future_failure.value is failure
+    assert router._usage_snapshot().aggregate_items == 0
+
