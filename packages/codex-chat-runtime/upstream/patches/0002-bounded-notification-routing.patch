+    else:
+        router.register_login("route-1")
+
+        def login_read() -> Notification:
+            return router.next_login_notification("route-1")
+
+        def unregister_login() -> None:
+            router.unregister_login("route-1")
+
+        read = login_read
+        unregister = unregister_login
+        expected_waiters = {"login": 1}
+
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        future = executor.submit(read)
+        _wait_for_router_waiters(router, **expected_waiters)
