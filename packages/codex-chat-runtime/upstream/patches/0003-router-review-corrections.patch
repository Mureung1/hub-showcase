+def test_fail_all_releases_every_retained_adopted_route() -> None:
+    router = MessageRouter()
+    router.register_turn("active-turn")
+    router.register_login("active-login")
+    notifications = [
+        Notification(
+            method="unknown/active-turn",
+            payload=UnknownNotification(params={"turnId": "active-turn"}),
+        ),
+        Notification(
+            method="unknown/pending-turn",
+            payload=UnknownNotification(params={"turnId": "pending-turn"}),
+        ),
+        Notification(
+            method="account/login/completed",
+            payload=UnknownNotification(params={"loginId": "active-login"}),
+        ),
+        Notification(
+            method="account/login/completed",
+            payload=UnknownNotification(params={"loginId": "pending-login"}),
+        ),
+        Notification(
+            method="unknown/global",
+            payload=UnknownNotification(params={"text": "retained"}),
+        ),
+    ]
+    for notification in notifications:
+        router.route_notification(notification)
+
+    before = router._usage_snapshot()
+    assert (
+        before.active_turn_routes,
+        before.pending_turn_routes,
+        before.active_login_routes,
+        before.pending_login_routes,
+        before.turn_items,
+        before.login_items,
+        before.global_items,
+        before.aggregate_items,
+    ) == (1, 1, 1, 1, 2, 2, 1, 5)
+    assert before.aggregate_bytes > 0
+
+    router.fail_all(RuntimeError("transport lost"))
+
+    _assert_router_usage_zero(router)
