+def test_global_dequeue_releases_item_and_byte_accounting() -> None:
+    router = MessageRouter(_RouterLimits(global_items=1, aggregate_items=1))
+    notification = Notification(
+        method="unknown/global",
+        payload=UnknownNotification(params={"text": "é"}),
+    )
+
+    router.route_notification(notification)
+    notification_bytes = router._notification_byte_count(notification)
+    usage = router._usage_snapshot()
+    assert (
+        usage.global_items,
+        usage.global_bytes,
+        usage.aggregate_items,
+        usage.aggregate_bytes,
+    ) == (1, notification_bytes, 1, notification_bytes)
+
+    assert router.next_global_notification() is notification
