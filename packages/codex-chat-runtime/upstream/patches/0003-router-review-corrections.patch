+def test_reader_response_decode_failure_settles_the_registered_waiter() -> None:
+    client = CodexClient()
+    waiter = client._router.create_response_waiter("request-1")
+    malformed_response = {
+        "id": "request-1",
+        "error": {"code": "not-an-int", "message": "bad"},
+    }
+    client._read_message = lambda: malformed_response
+
+    client._reader_loop()
+
+    failure = waiter.get(timeout=1)
+    assert isinstance(failure, ValueError)
+    with pytest.raises(ValueError) as future_failure:
+        client._router.create_response_waiter("request-2")
+    assert future_failure.value is failure
+    _assert_router_usage_zero(client._router)
+
