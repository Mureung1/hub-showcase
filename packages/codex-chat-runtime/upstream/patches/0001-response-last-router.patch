@@ -340,0 +358,54 @@ def test_turn_notification_router_clears_unregistered_turn_when_completed() -> N
+    replay_entered = threading.Event()
+    release_replay = threading.Event()
+    route_started = threading.Event()
+    route_done = threading.Event()
+
+    class BlockingFirstPutQueue(queue.Queue[object]):
+        first_put = True
+
+        def put(
+            self,
+            item: object,
+            block: bool = True,
+            timeout: float | None = None,
+        ) -> None:
+            if self.first_put:
+                self.first_put = False
+                replay_entered.set()
+                assert release_replay.wait(timeout=2)
+            super().put(item, block=block, timeout=timeout)
+
+    original_queue = queue.Queue
+    queue.Queue = BlockingFirstPutQueue  # type: ignore[misc]
+    try:
+        register = threading.Thread(
+            target=client.register_turn_notifications,
+            args=("turn-1",),
+        )
+        register.start()
+        assert replay_entered.wait(timeout=1)
+
+        def route_live() -> None:
+            route_started.set()
+            client._router.route_notification(
+                Notification(
+                    method="item/completed",
+                    payload=UnknownNotification(
+                        params={"threadId": "thread-1", "turnId": "turn-1"}
+                    ),
+                )
+            )
+            route_done.set()
+
+        live = threading.Thread(target=route_live)
+        live.start()
+        assert route_started.wait(timeout=1)
+        assert not route_done.wait(timeout=0.05)
+        release_replay.set()
+        register.join(timeout=1)
+        live.join(timeout=1)
+        assert not register.is_alive()
+        assert not live.is_alive()
+    finally:
+        queue.Queue = original_queue  # type: ignore[misc]
+        release_replay.set()
@@ -342 +413,4 @@ def test_turn_notification_router_clears_unregistered_turn_when_completed() -> N
-    assert client._router._pending_turn_notifications == {}
+    assert [
+        client.next_turn_notification("turn-1").method,
+        client.next_turn_notification("turn-1").method,
+    ] == ["item/agentMessage/delta", "item/completed"]
