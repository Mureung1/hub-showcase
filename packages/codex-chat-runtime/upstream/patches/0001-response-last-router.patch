+    replay_entered = threading.Event()
+    release_replay = threading.Event()
+    route_started = threading.Event()
+    route_done = threading.Event()
+
+    class BlockingFirstPutQueue(queue.Queue[object]):
+        first_put = True
+
+        def put(
