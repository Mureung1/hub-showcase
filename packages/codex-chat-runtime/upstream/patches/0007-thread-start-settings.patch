diff --git a/sdk/python/tests/test_public_api_runtime_behavior.py b/sdk/python/tests/test_public_api_runtime_behavior.py
index 4cee695..d798844 100644
--- a/sdk/python/tests/test_public_api_runtime_behavior.py
+++ b/sdk/python/tests/test_public_api_runtime_behavior.py
@@ -4,0 +5 @@ from pathlib import Path
+from types import SimpleNamespace
@@ -130,0 +132,27 @@ def test_async_codex_initializes_only_once_under_concurrency() -> None:
+def test_thread_start_preserves_native_effective_model_settings() -> None:
+    response = SimpleNamespace(
+        thread=SimpleNamespace(id="thread-1"),
+        model="configured-model",
+        reasoning_effort=SimpleNamespace(root="high"),
+    )
+    sync_codex = object.__new__(Codex)
+    sync_codex._client = SimpleNamespace(thread_start=lambda _params: response)
+    sync_thread = sync_codex.thread_start()
+    assert sync_thread.initial_model == "configured-model"
+    assert sync_thread.initial_reasoning_effort.root == "high"
+
+    async def scenario() -> None:
+        async_codex = AsyncCodex()
+        async_codex._initialized = True
+
+        async def fake_thread_start(_params):  # noqa: ANN202
+            return response
+
+        async_codex._client.thread_start = fake_thread_start  # type: ignore[method-assign]
+        async_thread = await async_codex.thread_start()
+        assert async_thread.initial_model == "configured-model"
+        assert async_thread.initial_reasoning_effort.root == "high"
+
+    asyncio.run(scenario())
+
+
