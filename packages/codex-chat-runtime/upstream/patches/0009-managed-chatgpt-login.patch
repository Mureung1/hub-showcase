@@ -113,0 +152,48 @@ def _assert_router_usage_zero(router: MessageRouter) -> None:
+def test_login_completion_wait_is_scoped_to_the_exact_attempt() -> None:
+    client = CodexClient()
+    client.register_login_notifications("login-wanted")
+    unrelated = client._coerce_notification(
+        "account/login/completed",
+        {"error": None, "loginId": "login-unrelated", "success": True},
+    )
+    matching = client._coerce_notification(
+        "account/login/completed",
+        {"error": None, "loginId": "login-wanted", "success": True},
+    )
+    client._router.route_notification(unrelated)
+
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        waiting = executor.submit(
+            client.wait_for_login_completed,
+            "login-wanted",
+        )
+        _wait_for_router_waiters(client._router, login=1)
+        client._router.route_notification(matching)
+        completed = waiting.result(timeout=1)
+
+    assert (completed.login_id, completed.success) == ("login-wanted", True)
+    client.register_login_notifications("login-unrelated")
+    assert client.next_login_notification("login-unrelated") is unrelated
+    client.unregister_login_notifications("login-unrelated")
+    _assert_router_usage_zero(client._router)
+
+
+def test_login_completion_wait_closes_with_the_transport() -> None:
+    client = CodexClient()
+    client.register_login_notifications("login-pending")
+
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        waiting = executor.submit(
+            client.wait_for_login_completed,
+            "login-pending",
+        )
+        _wait_for_router_waiters(client._router, login=1)
+        failure = TransportClosedError("transport closed during login")
+        client._router.fail_all(failure)
+        with pytest.raises(TransportClosedError) as caught:
+            waiting.result(timeout=1)
+
+    assert caught.value is failure
+    _assert_router_usage_zero(client._router)
+
+
