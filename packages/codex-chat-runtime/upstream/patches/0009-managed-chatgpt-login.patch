+    LoginAccountResponse,
+    LoginAppBrand,
@@ -137,0 +146,134 @@ def test_async_codex_initializes_only_once_under_concurrency() -> None:
+def test_managed_chatgpt_login_uses_hosted_codex_options_sync_and_async() -> None:
+    completion = AccountLoginCompletedNotification(
+        error=None,
+        login_id="login-managed",
+        success=True,
+    )
+    cancellation = CancelLoginAccountResponse(
+        status=CancelLoginAccountStatus.canceled,
+    )
+    response = LoginAccountResponse(
+        root=ChatgptLoginAccountResponse(
+            auth_url="https://example.invalid/managed-login",
+            login_id="login-managed",
+            type="chatgpt",
+        )
+    )
+    requests: list[dict[str, object]] = []
+
+    class FakeSyncLoginClient:
+        def account_login_start(self, params):  # noqa: ANN001,ANN202
+            requests.append(
+                params.model_dump(
+                    by_alias=True,
+                    exclude_none=True,
+                    mode="json",
+                )
+            )
+            return response
+
+        def wait_for_login_completed(
+            self,
+            login_id: str,
+        ) -> AccountLoginCompletedNotification:
+            assert login_id == "login-managed"
+            return completion
+
+        def account_login_cancel(self, login_id: str) -> CancelLoginAccountResponse:
+            assert login_id == "login-managed"
+            return cancellation
+
+    sync_codex = object.__new__(Codex)
+    sync_codex._client = FakeSyncLoginClient()
+    sync_handle = sync_codex.login_chatgpt()
+
+    assert (sync_handle.wait(), sync_handle.cancel()) == (completion, cancellation)
+
+    async def scenario() -> None:
+        class FakeAsyncLoginClient:
+            async def account_login_start(self, params):  # noqa: ANN001,ANN202
+                requests.append(
+                    params.model_dump(
+                        by_alias=True,
+                        exclude_none=True,
+                        mode="json",
+                    )
+                )
+                return response
+
+            async def wait_for_login_completed(
+                self,
+                login_id: str,
+            ) -> AccountLoginCompletedNotification:
+                assert login_id == "login-managed"
+                return completion
+
+            async def account_login_cancel(
+                self,
+                login_id: str,
+            ) -> CancelLoginAccountResponse:
+                assert login_id == "login-managed"
+                return cancellation
+
+        async_codex = AsyncCodex()
+        async_codex._client = FakeAsyncLoginClient()  # type: ignore[assignment]
+        async_codex._initialized = True
+        async_handle = await async_codex.login_chatgpt()
+
+        assert (await async_handle.wait(), await async_handle.cancel()) == (
+            completion,
+            cancellation,
+        )
+
+    asyncio.run(scenario())
+
+    assert requests == [
+        {
+            "appBrand": LoginAppBrand.codex.value,
+            "type": "chatgpt",
+            "useHostedLoginSuccessPage": True,
+        },
+        {
+            "appBrand": LoginAppBrand.codex.value,
+            "type": "chatgpt",
+            "useHostedLoginSuccessPage": True,
+        },
+    ]
+
+
+def test_managed_chatgpt_login_propagates_start_failure_and_cleans_unexpected_route() -> None:
+    start_failure = InvalidRequestError(-32600, "managed login unavailable")
+
+    class FailingClient:
+        def account_login_start(self, _params):  # noqa: ANN001,ANN202
+            raise start_failure
+
+    codex = object.__new__(Codex)
+    codex._client = FailingClient()
+    with pytest.raises(InvalidRequestError) as caught:
+        codex.login_chatgpt()
+    assert caught.value is start_failure
+
+    unexpected = LoginAccountResponse(
+        root=ChatgptDeviceCodeLoginAccountResponse(
+            login_id="login-unexpected",
+            type="chatgptDeviceCode",
+            user_code="ABCD-EFGH",
+            verification_url="https://example.invalid/device",
+        )
+    )
+    released: list[str] = []
+
+    class UnexpectedClient:
+        def account_login_start(self, _params):  # noqa: ANN001,ANN202
+            return unexpected
+
+        def unregister_login_notifications(self, login_id: str) -> None:
+            released.append(login_id)
+
+    codex._client = UnexpectedClient()
+    with pytest.raises(RuntimeError, match="unexpected ChatGPT login response"):
+        codex.login_chatgpt()
+    assert released == ["login-unexpected"]
+
+
