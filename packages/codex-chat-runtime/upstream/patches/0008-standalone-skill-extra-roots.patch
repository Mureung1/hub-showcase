+def _skill_extra_roots_params(
+    extra_roots: Sequence[str],
+) -> SkillsExtraRootsSetParams:
+    """Build exact typed params without accepting scalar strings or path-like values."""
+    if isinstance(extra_roots, (str, bytes)):
+        raise TypeError("extra_roots must be a sequence of strings")
+    roots = list(extra_roots)
+    if any(not isinstance(root, str) for root in roots):
+        raise TypeError("extra_roots must contain only strings")
+    return SkillsExtraRootsSetParams(extra_roots=roots)
+
