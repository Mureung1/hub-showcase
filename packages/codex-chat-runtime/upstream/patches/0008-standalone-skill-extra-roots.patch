diff --git a/sdk/python/tests/test_public_api_runtime_behavior.py b/sdk/python/tests/test_public_api_runtime_behavior.py
index d798844..5a04c66 100644
--- a/sdk/python/tests/test_public_api_runtime_behavior.py
+++ b/sdk/python/tests/test_public_api_runtime_behavior.py
@@ -17 +17,7 @@ from openai_codex.api import (
-from openai_codex.generated.v2_all import TurnStartParams
+from openai_codex.async_client import AsyncCodexClient
+from openai_codex.client import CodexClient
+from openai_codex.generated.v2_all import (
+    SkillsExtraRootsSetParams,
+    SkillsExtraRootsSetResponse,
+    TurnStartParams,
+)
@@ -158,0 +165,60 @@ def test_thread_start_preserves_native_effective_model_settings() -> None:
+def test_skill_extra_roots_preserve_sequence_and_use_typed_request() -> None:
+    requests: list[tuple[str, dict[str, object], type[object]]] = []
+
+    def fake_request(
+        method: str,
+        params: dict[str, object],
+        *,
+        response_model: type[object],
+    ) -> object:
+        requests.append((method, params, response_model))
+        return SkillsExtraRootsSetResponse.model_validate({})
+
+    sync_client = object.__new__(CodexClient)
+    sync_client.request = fake_request  # type: ignore[method-assign]
+    sync_codex = object.__new__(Codex)
+    sync_codex._client = sync_client
+
+    roots = ("/skills/first", "/skills/first", "/skills/second")
+    response = sync_codex.set_skill_extra_roots(roots)
+
+    assert isinstance(response, SkillsExtraRootsSetResponse)
+    assert requests == [
+        (
+            "skills/extraRoots/set",
+            {"extraRoots": list(roots)},
+            SkillsExtraRootsSetResponse,
+        )
+    ]
+
+    async def scenario() -> None:
+        async_client = object.__new__(AsyncCodexClient)
+        async_client._sync = sync_client
+        async_codex = AsyncCodex()
+        async_codex._client = async_client
+        async_codex._initialized = True
+
+        async_roots = ["/skills/third", "/skills/second"]
+        async_response = await async_codex.set_skill_extra_roots(async_roots)
+        assert isinstance(async_response, SkillsExtraRootsSetResponse)
+        assert requests[-1] == (
+            "skills/extraRoots/set",
+            {"extraRoots": async_roots},
+            SkillsExtraRootsSetResponse,
+        )
+
+    asyncio.run(scenario())
+
+
+def test_skill_extra_roots_reject_scalar_and_non_string_values() -> None:
+    params: list[SkillsExtraRootsSetParams] = []
+    codex = object.__new__(Codex)
+    codex._client = SimpleNamespace(skills_extra_roots_set=lambda value: params.append(value))
+
+    for invalid in ("/skills/scalar", [Path("/skills/path-like")], ["/skills", 1]):
+        with pytest.raises(TypeError, match="sequence of strings|only strings"):
+            codex.set_skill_extra_roots(invalid)  # type: ignore[arg-type]
+
+    assert params == []
+
+
