+        ),
+        AsyncCodex.set_skill_extra_roots: (
+            "(self, extra_roots: 'Sequence[str]') -> 'SkillsExtraRootsSetResponse'"
+        ),
+    }
+    _assert_no_any_annotations(Codex.set_skill_extra_roots)
+    _assert_no_any_annotations(AsyncCodex.set_skill_extra_roots)
+
+
