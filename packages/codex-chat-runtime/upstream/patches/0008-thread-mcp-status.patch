+)
@@ -158,0 +162,34 @@ def test_thread_start_preserves_native_effective_model_settings() -> None:
+def test_async_codex_mcp_server_statuses_uses_thread_project_context() -> None:
+    async def scenario() -> None:
+        codex = AsyncCodex()
+        requests: list[tuple[str, object, object]] = []
+
+        async def fake_ensure_initialized() -> None:
+            return None
+
+        async def fake_request(
+            method: str,
+            params: object,
+            *,
+            response_model: object,
+        ) -> ListMcpServerStatusResponse:
+            requests.append((method, params, response_model))
+            return ListMcpServerStatusResponse(data=[])
+
+        codex._ensure_initialized = fake_ensure_initialized  # type: ignore[method-assign]
+        codex._client.request = fake_request  # type: ignore[method-assign]
+
+        response = await codex.mcp_server_statuses("thread-1")
+
+        assert response.data == []
+        assert requests == [
+            (
+                "mcpServerStatus/list",
+                {"detail": "toolsAndAuthOnly", "threadId": "thread-1"},
+                ListMcpServerStatusResponse,
+            )
+        ]
+
+    asyncio.run(scenario())
+
+
