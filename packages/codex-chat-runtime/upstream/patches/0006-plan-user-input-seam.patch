+def test_async_user_input_surface_is_typed_and_hides_transport_identity() -> None:
+    """Deferred interaction APIs expose native scope but not JSON-RPC request ids."""
+    assert list(AsyncUserInputRequest.__dataclass_fields__) == [
+        "thread_id",
+        "turn_id",
+        "item_id",
+        "questions",
+        "auto_resolution_ms",
+        "_client",
+        "_token",
+    ]
+    assert "request_id" not in AsyncUserInputRequest.__dataclass_fields__
+    assert inspect.iscoroutinefunction(AsyncCodex.next_user_input)
+    assert inspect.signature(AsyncCodex.next_user_input).return_annotation == (
+        "AsyncUserInputRequest"
+    )
+    assert inspect.iscoroutinefunction(AsyncUserInputRequest.answer)
+    assert inspect.iscoroutinefunction(AsyncUserInputRequest.cancel)
+    assert UserInputOption.__dataclass_fields__.keys() == {"label", "description"}
+    assert UserInputQuestion.__dataclass_fields__.keys() == {
+        "id",
+        "header",
+        "question",
+        "options",
+        "is_other",
+        "is_secret",
+    }
+    assert issubclass(UserInputRequestError, Exception)
+
