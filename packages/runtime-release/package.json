{
  "name": "@ay-ple/runtime-release",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "NODE_OPTIONS=--conditions=development tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verify:package-root": "npm run build && tsx src/testing/verify-built-package-root.ts"
  },
  "dependencies": {
    "tar-stream": "3.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/tar-stream": "3.1.4",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2"
  }
}
