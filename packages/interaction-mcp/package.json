{
  "name": "@ay-ple/interaction-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "ay-ple-interaction-mcp": "dist/stdio.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 dist/stdio.js",
    "test": "npm run build && NODE_OPTIONS=--conditions=development tsx --test \"src/**/*.test.ts\" && npm run verify:package-root",
    "typecheck": "tsc --noEmit",
    "verify:package-root": "npm run build && tsx src/testing/verify-built-package-root.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2"
  }
}
