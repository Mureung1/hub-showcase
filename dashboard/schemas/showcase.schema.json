{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "summary",
    "category",
    "problem",
    "features",
    "featureTags",
    "techStack",
    "githubUser",
    "thumbnail",
    "agent"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 160 },
    "category": {
      "enum": [
        "소상공인 운영",
        "지역 상권과 홍보",
        "대학 생활",
        "학습과 진로",
        "생활 편의",
        "공공·지역 문제",
        "그 외"
      ]
    },
    "problem": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "targetUsers": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "featureTags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 30 }
    },
    "techStack": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "techHighlights": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "githubUser": { "type": "string", "minLength": 1, "maxLength": 80 },
    "demoUrl": { "type": "string", "maxLength": 500 },
    "thumbnail": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+\\.(webp|png|jpg|jpeg)$"
    },
    "screenshots": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+\\.(webp|png|jpg|jpeg)$"
      }
    },
    "agent": {
      "type": "object",
      "required": ["summary", "agents", "skills", "workflows"],
      "properties": {
        "summary": { "type": "string", "maxLength": 1000 },
        "agents": { "type": "array", "items": { "type": "string" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "workflows": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
