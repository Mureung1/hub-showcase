{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 160 },
    "problem": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "targetUsers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "features": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "featureTags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 30 }
    },
    "techStack": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "techHighlights": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "githubUser": { "type": "string", "minLength": 1, "maxLength": 80 },
    "demoUrl": { "type": "string", "maxLength": 500 },
    "demoVideoUrl": { "type": "string", "maxLength": 500, "pattern": "^$|^https://" },
    "projectIntroUrl": { "type": "string", "maxLength": 500, "pattern": "^$|^https://" },
    "thumbnail": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+\\.(webp|png|jpg|jpeg)$"
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+\\.(webp|png|jpg|jpeg)$"
      }
    },
    "agent": {
      "type": "object",
      "required": [],
      "properties": {
        "summary": { "type": "string", "maxLength": 1000 },
        "agentTools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "name", "purpose"],
            "properties": {
              "type": { "enum": ["agent", "skill"] },
              "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "purpose": { "type": "string", "minLength": 1, "maxLength": 200 }
            },
            "additionalProperties": false
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "steps"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1, "maxLength": 100 }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "developmentWithAI": { "type": "string", "minLength": 1, "maxLength": 800 }
  },
  "additionalProperties": false
}
