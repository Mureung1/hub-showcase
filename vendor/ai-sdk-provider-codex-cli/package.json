{
  "name": "ai-sdk-provider-codex-cli",
  "version": "2.1.1",
  "private": true,
  "description": "Private AY-PLE fork of the Codex CLI App Server client donor",
  "keywords": [
    "ai-sdk",
    "codex",
    "openai",
    "cli",
    "language-model",
    "gpt-5.5",
    "provider"
  ],
  "license": "MIT",
  "author": "Ben Vargas",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "upstream/openai-codex/LICENSE",
    "upstream/openai-codex/NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate": "npm run verify:codex-pin && npm run verify:codex-generated && npm run build && npm run verify:private-boundary && npm run typecheck && npm run format && npm run lint && npm run test",
    "validate:docs": "node scripts/validate-doc-snippets.mjs",
    "validate:examples:app-server": "node scripts/validate-app-server-examples.mjs",
    "validate:full": "npm run validate && npm run validate:docs && npm run validate:examples:app-server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:codex-pin": "node scripts/verify-codex-pin.mjs",
    "verify:private-boundary": "node scripts/verify-private-package-boundary.mjs",
    "generate:codex-protocol": "node scripts/generate-codex-protocol.mjs --write",
    "verify:codex-generated": "node scripts/generate-codex-protocol.mjs --check"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "@ai-sdk/provider-utils": "^5.0.0",
    "ajv": "^8.20.0",
    "jsonc-parser": "^3.3.1"
  },
  "optionalDependencies": {
    "@openai/codex": "0.144.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "ai": "^7.0.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tsup": "8.5.1",
    "typescript": "5.6.3",
    "vitest": "^3.2.4",
    "typescript-eslint": "^8.6.0",
    "zod": "^4.1.8"
  },
  "peerDependencies": {
    "zod": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
