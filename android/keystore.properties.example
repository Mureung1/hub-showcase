# 이 파일을 같은 폴더에 keystore.properties 로 복사한 뒤 값을 채운다.
# keystore.properties 와 *.jks / *.keystore 는 .gitignore에 걸려 있어 커밋되지 않는다.
#
# 키스토어 만들기(둘 중 하나):
#   (A) Android Studio → Build → Generate Signed Bundle / APK → APK → Create new...
#   (B) 터미널에서 직접(비밀번호·이름 등은 프롬프트로 물어본다):
#       & "C:\Program Files\Android\Android Studio\jbr\bin\keytool.exe" -genkeypair -v `
#         -keystore android\mealyze-release.jks -alias mealyze `
#         -keyalg RSA -keysize 2048 -validity 10000
#
# ⚠️ 키스토어 파일과 비밀번호를 잃어버리면 **같은 앱으로는 영원히 업데이트할 수 없다.**
#    applicationId가 같아도 서명이 다르면 기기가 설치를 거부하고, 사용자는 기존 앱을 지우고
#    새로 깔아야 한다(게스트 모드 로컬 데이터도 함께 사라진다). 파일과 비밀번호를 이 저장소
#    바깥의 안전한 곳에 따로 백업해 둘 것 — validity 10000일(약 27년)은 키를 잃지 않았을
#    때의 이야기다.

# android/ 기준 상대경로 또는 절대경로
storeFile=mealyze-release.jks
storePassword=
keyAlias=mealyze
keyPassword=
