<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ⚠️ allowBackup="false" — 안드로이드 자동 백업을 끈다.
         이 앱의 화면은 WebView이고 로그인 세션(Supabase JWT + refresh token)과 게스트 모드
         식단 데이터가 전부 WebView localStorage, 즉 앱 내부 저장소에 있다. 기본값인 true로 두면
         그게 통째로 구글 드라이브 자동 백업에 올라가 **refresh token이 클라우드에 사본으로 남는다**
         (백업을 복원하면 남의 기기에서 로그인 상태가 되살아날 수 있고, 사용자는 그런 사본이
         생긴 줄도 모른다).
         잃는 기능은 없다 — 기기 이전용 백업/복원은 MY 탭의 CSV 내보내기/가져오기가 담당하고,
         그쪽이 무엇이 옮겨가는지 사용자에게 명시적으로 보여준다.
         targetSdk 31+에서는 allowBackup=false만으로는 기기 간 직접 전송(D2D)이 안 막히므로
         dataExtractionRules로 양쪽을 다 끈다. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 네트워크 연결 상태 확인용(서버 URL 방식이라 인터넷이 필수 — 오프라인 안내 등에 사용) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 사진 촬영/선택(음식 사진 분석용 <input type=file accept=image/*>가 웹뷰에서 카메라를 쓸 때 필요) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 주변 식당 찾기(navigator.geolocation)용 위치 권한 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- CSV 내보내기(@capacitor/filesystem이 공용 Documents 폴더에 저장)용.
         안드로이드 10(API 29)부터는 Scoped Storage라 "앱이 만든 파일"에는 이 권한 없이도 쓸 수 있어
         maxSdkVersion으로 상한을 둔다 — 최신 기기에 불필요한 저장소 권한을 요구하지 않기 위해서다.
         저장이 막히는 기기에서는 fileExport.js가 앱 캐시 폴더 + 공유 시트로 자동 폴백한다. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- 카메라가 없는 기기에도 설치될 수 있게 카메라는 필수가 아님으로 선언 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
