# 모두의 뇌 맥락 분석 API 설정
# 기본값은 API 키 없이 동작하는 local-heuristic provider입니다.
MODU_BRAIN_ANALYSIS_PROVIDER=local-heuristic

# 실제 OpenAI Responses API를 사용할 때만 아래 값을 서버 환경에 설정합니다.
# 비용과 모델 가용성을 명시적으로 확인한 뒤 provider를 openai로 바꾸세요.
# 클라이언트 코드, 문서, 커밋에는 실제 API 키를 넣지 않습니다.
# MODU_BRAIN_ANALYSIS_PROVIDER=openai
# MODU_BRAIN_OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=

# preview 서버는 기본적으로 127.0.0.1에만 바인딩됩니다.
# 외부 공개 배포에는 별도의 인증과 요청 제한을 먼저 추가해야 합니다.
# HOST=127.0.0.1
