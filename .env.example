# Supabase connection details for the TypeScript test suite.
# Copy to `.env` and fill in the values printed by `supabase start`.
#
#   supabase start        # prints API URL, anon key, service_role key
#
# The DB connection string is used by the pg_prove DB test runner alternative.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Direct Postgres connection (used by `npm run db:test:prove`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------
# Drizzle data layer (server-side writes / transactions + migrations).
#
# Connection-string separation (design.md "Connection & Pooling 전략"):
#   - Write/transaction path (src/db/index.ts) connects through the Supabase
#     Connection Pooler in SESSION mode so that `db.transaction()` + `FOR UPDATE`
#     row locks behave correctly under serverless connection fan-out.
#   - Migrations (drizzle.config.ts / drizzle-kit) use a DIRECT (non-pooled)
#     connection.
#
# Provide the KEYS here only — never commit real secrets.
#
# Local Supabase (`supabase start`) example values are shown as placeholders.
# For a hosted project use the pooler host on port 5432 (SESSION mode) for the
# pool URL and the direct db host on port 5432 for the direct URL.

# App / write path — SESSION-mode Connection Pooler connection string.
DATABASE_SESSION_POOL_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Migrations — DIRECT (non-pooled) connection string used by drizzle-kit.
DATABASE_DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
