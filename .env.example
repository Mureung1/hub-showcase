# 프론트엔드(Vite) — 클라이언트 번들에 포함되는 값. Supabase anon key는 공개돼도 되는 키
# (RLS로 접근 제어), 배포 시 Vercel 프로젝트의 환경변수로 등록하세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 프론트엔드 → 백엔드(Express) 요청 주소. 로컬 개발은 비워두면 http://localhost:3001로 자동 폴백됩니다.
# 배포 시에는 Render 등에 올린 Express 서버의 실제 URL을 넣으세요(예: https://your-app.onrender.com).
VITE_API_BASE_URL=

# 백엔드(Express, server/) 전용 — 절대 클라이언트에 노출되면 안 되는 값.
# 배포 시 Render 등 백엔드 호스팅 플랫폼의 환경변수로 등록하세요.
GEMINI_API_KEY=
PORT=3001

# CORS 허용 도메인 — 배포된 프론트엔드(Vercel) 주소를 넣으세요(예: https://your-app.vercel.app).
# 비워두면(로컬 개발) 모든 origin을 허용합니다.
FRONTEND_ORIGIN=
