# WeatherPilot 환경변수 예시 — 실제 값은 apps/server/.env 에 넣고 커밋하지 말 것.
# 서버 전용 시크릿. 프론트(apps/web)에는 절대 두지 않는다.

# 기상청 단기예보 (공공데이터포털) — 일반 인증키(Decoding)
KMA_SERVICE_KEY=

# OpenWeatherMap API 키 (1-3에서 사용)
OWM_API_KEY=

# Supabase (1-6에서 사용) — service_role/secret 키는 서버 전용, 프론트 금지
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# LLM 제안 생성 (2-2). 현재 Groq 무료 티어 사용 (문서 기준은 Claude — provider 교체 가능)
GROQ_API_KEY=
