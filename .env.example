# 서버와 Drizzle migration에서만 사용하는 Neon PostgreSQL 연결 문자열
DATABASE_URL=

# 실제 개발 DB에 임시 smoke row를 기록·정리할 때만 아래 값을 사용
DB_SMOKE_CONFIRM=t30-development-write

# AI 경로(guided_ai/manual_ai) provider. 비어 있으면 provider가 unconfigured로 남아
# 항상 template fallback으로 빠진다 (T20).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# T35 비프로덕션 retrieval ingestion/smoke에서만 사용한다.
# 1024차원 float 출력을 지원하는 Voyage embedding model을 명시한다.
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-lite

# 개발 DB에 retrieval embedding을 쓰는 명령을 실행할 때만 아래 값을 사용한다.
# retrieval:smoke는 합성 임시 행을 실행 종료 전에 삭제한다.
RETRIEVAL_INGEST_CONFIRM=t35-development-write
