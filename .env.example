# AI providers (server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
AI_PROVIDER=gemini
ALLOW_LIVE_OPENAI=false
ALLOW_LIVE_GEMINI=false

# Local demo persistence (server only; enabled by default without external keys)
OPPORTUNITY_STORAGE_PROVIDER=sqlite
ALLOW_LOCAL_PERSISTENCE=true
LOCAL_DATABASE_PATH=./data/uniradar-demo.sqlite

# Supabase Auth and account profile storage
# VITE_ values are public browser configuration. Never place a service role key here.
# Leave empty for local Vite proxy. Set the Render API origin on Vercel, without a trailing slash.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional server-only Supabase opportunity persistence
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_OPPORTUNITIES_TABLE=opportunity_analyses
ALLOW_SUPABASE_PERSISTENCE=false

# Local-safe runtime defaults
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
SERVE_CLIENT=false
PUBLIC_URL=http://127.0.0.1:3001
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY=false

# Basic unauthenticated analysis protection (production default: enabled)
ANALYZE_RATE_LIMIT_ENABLED=false
ANALYZE_RATE_LIMIT_MAX=10
ANALYZE_RATE_LIMIT_WINDOW_MS=60000

# Registered notice discovery cache (no arbitrary URLs are fetched)
DISCOVERY_CACHE_TTL_MS=300000
