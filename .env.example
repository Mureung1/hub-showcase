# 실제 값은 .env에 넣는다. 이 파일에는 키 이름과 설명만 남긴다.
# 새 환경변수를 추가하면 여기에도 반드시 추가한다.

# --- 백엔드 (backend/.env) ---
# 브라우저에 노출되지 않는다. 시크릿을 여기에 둔다.

# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=

# --- 프론트엔드 (frontend/.env) ---
# VITE_ 접두사가 붙은 값은 번들에 포함되어 브라우저에 그대로 노출된다.
# 공개해도 되는 값만 둔다. 시크릿은 절대 넣지 않는다.

# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
