# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Database (Supabase — 이슈 #3)
# Project Settings > API 에서 확보. service_role 키는 서버 전용, 절대 커밋 금지
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API (이슈 #67) — 첨부파일 AI 구조화 추출. https://aistudio.google.com/apikey 에서 무료 발급
GEMINI_API_KEY=

# bizinfo.go.kr Open API (이슈 #28~)
BIZINFO_API_KEY=

# Client 빌드 (이슈 #56) — GitHub Pages처럼 client·server가 다른 호스트에 배포될 때만 필요.
# 같은 호스트에서 서빙하거나 로컬 개발(Vite 프록시)이면 비워두면 상대 경로(/api/...)로 동작.
VITE_API_BASE_URL=
