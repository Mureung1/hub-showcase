# AI providers (server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
AI_PROVIDER=mock
ALLOW_LIVE_OPENAI=false
ALLOW_LIVE_GEMINI=false

# Local-safe runtime defaults
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
SERVE_CLIENT=false
PUBLIC_URL=http://127.0.0.1:3001
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY=false

# Basic unauthenticated analysis protection (production default: enabled)
ANALYZE_RATE_LIMIT_ENABLED=false
ANALYZE_RATE_LIMIT_MAX=10
ANALYZE_RATE_LIMIT_WINDOW_MS=60000
