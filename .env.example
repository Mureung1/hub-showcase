# ============================================================
# 팀플, 이지! 환경변수 — 이 파일을 복사해 .env 를 만들고 값을 채우세요.
# .env 는 .gitignore 에 있어 커밋되지 않습니다. (비밀 키는 절대 커밋 금지)
# ============================================================

# API 서버 포트
PORT=3001

# Supabase 프로젝트 URL
# 위치: 대시보드 ⚙ Project Settings → Data API  (형태: https://xxxxxxxx.supabase.co)
SUPABASE_URL=

# Supabase Secret key (sb_secret_ 으로 시작)
# 위치: 대시보드 → API Keys → Secret keys
# ⚠️ DB 전체 권한을 가진 마스터키 — 서버(.env) 밖으로 절대 내보내지 말 것
SUPABASE_SECRET_KEY=

# JWT 서명용 비밀 문자열 — 다른 곳에 쓰지 않은 32자 이상 무작위 문자열을 직접 만들어 입력
JWT_SECRET=

# Anthropic API 키 — console.anthropic.com 에서 발급 (에이전트 연동 단계 전까지 준비)
ANTHROPIC_API_KEY=

# 플래닝·역할 배정 에이전트가 사용할 Claude 모델
CLAUDE_MODEL=claude-sonnet-5

# ============================================================
# 배포(Vercel) — 프론트+API를 한 프로젝트가 같은 오리진으로 제공.
#   위 SUPABASE_URL·SUPABASE_SECRET_KEY·JWT_SECRET·ANTHROPIC_API_KEY·CLAUDE_MODEL 를
#   Vercel 대시보드 Environment Variables 에 그대로 입력한다(레포엔 커밋 금지).
#   NODE_ENV=production 은 Vercel이 자동 설정하므로 따로 넣지 않아도 된다.
# ============================================================
