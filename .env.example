# 서버와 Drizzle migration에서만 사용하는 Neon PostgreSQL 연결 문자열
DATABASE_URL=

# 실제 개발 DB에 임시 smoke row를 기록·정리할 때만 아래 값을 사용
DB_SMOKE_CONFIRM=t30-development-write

# AI 경로(guided_ai/manual_ai) provider. 비어 있으면 provider가 unconfigured로 남아
# 항상 template fallback으로 빠진다 (T20).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
