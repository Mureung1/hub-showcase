# Briefy 환경변수
# 이 파일을 .env로 복사한 뒤 실제 값을 채워 넣으세요.

# Express 서버 포트
PORT=3001

# Groq API
GROQ_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# (배포 시, BE 전용) FE 배포 도메인만 CORS 허용하려면 설정. 비워두면 전체 허용(로컬 개발 기본값)
CORS_ORIGIN=

# (배포 시, FE 전용 — Vite 빌드에 포함되므로 VITE_ 접두사 필수) BE API 주소.
# FE/BE를 같은 도메인에서 서빙하면(로컬 개발 포함) 비워둔다 — 상대 경로(/api/...)로 호출됨.
# FE(Vercel)와 BE(Render)를 다른 도메인에 배포할 때만 BE 배포 URL로 채운다.
VITE_API_BASE_URL=
