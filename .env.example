# Supabase 프로젝트(Settings → API)에서 확보 — Project URL / anon key(대시보드엔 "Publishable key"로 표시될 수 있음, 동일한 값)
# 브라우저에 노출돼도 되는 공개 값이지만 실제 값은 .env(gitignored)에만 넣고 커밋하지 않는다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 배포 시 프론트/백엔드가 다른 origin에 있을 때만 설정 (예: https://specfit-api.onrender.com).
# 비워두면(로컬 개발) 지금처럼 상대 경로(/api/...)로 호출해 Vite 프록시에 의존한다.
VITE_API_BASE_URL=
