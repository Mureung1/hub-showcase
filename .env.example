# 프론트엔드(Vite)용 환경변수 — VITE_ 접두사가 붙은 값만 클라이언트 번들에 노출된다.
# 로컬 개발 중엔 vite.config.js의 proxy 설정으로 /api를 서버로 넘기므로 보통 비워둬도 된다.
VITE_API_BASE_URL=

# Web Push용 public key만 프론트에 노출한다 (server/.env의 VAPID_PUBLIC_KEY와 동일 값).
# private key는 서버 전용이므로 절대 VITE_ 접두사로 노출하지 않는다.
VITE_VAPID_PUBLIC_KEY=

# 알림 재확인 간격 모드 — "demo"(초 단위, 시연용) | "production"(분 단위, 실제 서비스).
# 값을 비워두면(권장 기본값):
#   - 프로덕션 빌드(vite build) → production으로 동작 (배포 시 이 값을 깜빡 설정 안 해도
#     초 단위로 재촉하는 사고가 나지 않도록 하기 위한 안전한 기본값)
#   - 로컬 개발(vite dev) → demo로 동작
# 챌린지 시연용 배포에서 데모 속도를 쓰려면 이 값을 명시적으로 demo로 설정한다.
# "demo"/"production" 외의 값은 경고 후 무시되고 위 기본값 규칙을 따른다.
VITE_NUDGE_MODE=
