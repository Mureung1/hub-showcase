# 실제 값은 .env에 넣는다(.gitignore에 있음). 이 파일에는 **키 이름만** 둔다.
#
# VITE_ 접두 키는 `vite build` 시점에 번들에 인라인된다 — 값을 바꾸면 재빌드/재배포가 필요하고,
# 환경변수만 갈아끼우는 것으로는 반영되지 않는다. 나머지(접두 없는 키)는 서버 런타임에서만 읽는다.

# ── AI 분석 ─────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── 지도·장소 ───────────────────────────────────────────────────────────────
# KAKAO_REST_API_KEY는 좌표→행정동 역지오코딩(/api/reverse-geocode)에 계속 쓰인다.
# VITE_KAKAO_JS_KEY와 카카오 장소검색은 네이버 전환 후 롤백 경로로만 남아 있다(화면에서 미사용).
KAKAO_REST_API_KEY=
VITE_KAKAO_JS_KEY=
VITE_NAVER_MAP_CLIENT_ID=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ── 식약처 식품영양성분 DB ──────────────────────────────────────────────────
# FOODSAFETY_API_KEY = 음식DB, PROC = 가공식품DB, RECIPE = 조리식품 레시피DB.
FOODSAFETY_API_KEY=
FOODSAFETY_PROC_API_KEY=
FOODSAFETY_RECIPE_API_KEY=

# ── 학교 급식(NEIS 교육정보 개방포털) ───────────────────────────────────────
# 없으면 급식 조회가 실패한다 — 학교 프로필 사용자의 closed-set 프라이어·공식 영양 앵커링이
# 조용히 꺼진다(분석 자체는 open-set 경로로 계속되므로 화면에는 에러로 안 보인다).
NEIS_API_KEY=

# ── Supabase ────────────────────────────────────────────────────────────────
# ANON_KEY는 공개돼도 되는 키다(접근 제한은 RLS가 한다). SERVICE_ROLE_KEY는 **절대 공개 금지** —
# 서버에서만 읽고 비밀번호 찾기(/api/auth/*)에 쓴다. 빠지면 그 라우트 전체가 500이 되어
# 비밀번호 찾기가 동작하지 않고, 회원가입 시 보안질문 등록에서도 에러 토스트가 뜬다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 선택 ────────────────────────────────────────────────────────────────────
# APP_URL: OpenRouter에 보내는 HTTP-Referer(미설정 시 http://localhost:5173).
# VITE_API_BASE_URL: APK를 **로컬 번들 모드**로 빌드할 때만 채운다(배포된 백엔드 URL).
#   지금처럼 capacitor.config.json이 서버 URL 모드면 비워둬야 /api가 같은 오리진 상대경로로 간다.
APP_URL=
VITE_API_BASE_URL=
