# WeatherPilot 환경변수 예시 — 실제 값은 apps/server/.env 에 넣고 커밋하지 말 것.
# 서버 전용 시크릿. 프론트(apps/web)에는 절대 두지 않는다.
#
# 프론트 환경변수는 apps/web/.env.example 을 따른다 (VITE_MOCK_MODE · VITE_API_BASE).
# 아래 키가 없을 때의 동작은 README "환경변수" 표에 정리돼 있다.

# ── 필수 ────────────────────────────────────────────────────────────────────

# 기상청 단기예보 (공공데이터포털) — 일반 인증키(Decoding)
KMA_SERVICE_KEY=

# OpenWeatherMap API 키. 기상청과 가중 병합하고, 한쪽이 죽으면 남은 쪽으로 폴백한다.
OWM_API_KEY=

# Supabase — service_role/secret 키는 서버 전용, 프론트 금지
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# LLM 제안 생성. 현재 Groq 무료 티어 사용 (문서 기준은 Claude — provider 교체 가능)
GROQ_API_KEY=

# ── 문자 발송 (Solapi) ──────────────────────────────────────────────────────
# 비우면 실발송 없이 dry-run으로 동작한다(콘솔에만 남는다).
# 발신번호는 Solapi에서 사전 등록·인증된 번호만 쓸 수 있다.

SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
# 테스트 수신번호. 챌린지 스코프상 본인 번호에만 실발송한다.
SOLAPI_TEST_TO=
# 크론이 사장님에게 보내는 알림 수신번호. 없으면 SOLAPI_TEST_TO를 쓴다.
OWNER_PHONE=

# ── Instagram 자동 게시 (Graph API) ─────────────────────────────────────────
# 토큰·유저ID가 둘 다 있을 때만 실게시를 시도하고, 없거나 실패하면 화면이
# "문구 복사" 폴백으로 내려간다(없는 게시를 성공으로 꾸미지 않는다).

IG_ACCESS_TOKEN=
IG_USER_ID=
# 게시에 쓸 이미지 URL. Graph API는 공개 URL만 받는다(로컬 파일 업로드 불가).
IG_DEMO_IMAGE_URL=
# 아래 둘은 보통 비워 둔다.
#  IG_API_HOST — 비우면 토큰 접두로 자동 판별한다: IGAA…→graph.instagram.com,
#                EAA…→graph.facebook.com. 짝이 틀리면 Meta가 토큰 탓처럼 보이는
#                190 오류를 주므로, 자동 판별을 덮어쓸 이유가 없으면 두지 말 것.
#  IG_API_VERSION — 비우면 v21.0
IG_API_HOST=
IG_API_VERSION=

# ── 옵션 ────────────────────────────────────────────────────────────────────

# 서버 포트. 비우면 4000
PORT=
# 허용 오리진(쉼표 구분). 비우면 http://localhost:5173,https://weatherpilot-web.vercel.app
CORS_ORIGINS=
# 데모용 날씨 고정 — rain / clear / cold / heat 중 하나. 비우면 실제 예보를 쓴다.
# 고정 시 날씨 입력만 대체되고 진단·문구·발송은 그대로 실동작하며, 화면 소스 배지가
# "데모 고정 날씨 (실제 예보 API 미사용)"로 바뀐다. 배포에는 넣지 말 것.
DEMO_WEATHER=
# 값이 있으면 LLM 프롬프트·응답을 콘솔에 남긴다(디버깅용).
LLM_DEBUG=
