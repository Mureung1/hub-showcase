# Docker Compose project identity
COMPOSE_PROJECT_NAME=placepick

# Application and infrastructure ports (localhost only)
APP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
MOCK_NAVER_PORT=8089
MOCK_LLM_PORT=8090
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Local-only database credentials. Never reuse these outside local development.
POSTGRES_DB=placepick
POSTGRES_USER=placepick
POSTGRES_PASSWORD=placepick-local-only

# Local Grafana credentials. Change locally if the workstation is shared.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=placepick-local-only

# Fail-closed external integration policy for local, test, and load execution.
PLACEPICK_EXTERNAL_MODE=mock
PLACEPICK_NAVER_BASE_URL=http://mock-naver:8080
PLACEPICK_LLM_BASE_URL=http://mock-llm:8080

# k6 runs on the Compose network and reaches the Dev Container service directly.
BASE_URL=http://dev:8080
