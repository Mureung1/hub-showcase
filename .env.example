# Anthropic Claude API key (server-side only — never expose to the client bundle)
ANTHROPIC_API_KEY=

# server/
PORT=4000

# true면 llmService.js가 Claude API를 실제로 호출하지 않고 더미 응답을 반환한다
# (로컬 개발/통합 테스트용 — CLAUDE.md "구현 유의사항 · LLM 호출 비용 관리" 참고)
MOCK_LLM=true

# client/ (Vite only exposes VITE_-prefixed vars to the browser)
VITE_API_BASE_URL=http://localhost:4000
