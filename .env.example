# Production values belong in the Render dashboard, never in this file.

# Public deployment origin allowed to call the API
CLIENT_URL=https://your-vercel-project.vercel.app

# Server-only Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# Server-only guest key hashing secret (minimum 32 characters)
GUEST_KEY_PEPPER=

# Server-only generative AI configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_RATE_LIMIT_MAX=10

# Optional server hardening
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100
JSON_BODY_LIMIT=100kb
TRUST_PROXY_HOPS=1
