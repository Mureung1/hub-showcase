# Modu Brain local development configuration.
# Copy this file to .env and replace placeholders. Never commit .env.

# Supabase project settings used by the Node API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only. Never use a VITE_ prefix or expose this value to the browser.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Legacy JWT keys remain supported for local Supabase CLI environments.
# SUPABASE_ANON_KEY=your-legacy-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Browser Auth settings. The anon key is intentionally public and protected by RLS.
# These values usually match SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key

# The deterministic local provider is the safe default.
MODU_BRAIN_ANALYSIS_PROVIDER=local-heuristic
MODU_BRAIN_OPENAI_ENABLED=false
MODU_BRAIN_OPENAI_MODEL=gpt-5.6-terra
MODU_BRAIN_OPENAI_REASONING_EFFORT=low

# Required only when a signed-in user explicitly chooses the OpenAI provider.
# Confirm that the configured account can access the selected preview model.
OPENAI_API_KEY=
SAFETY_IDENTIFIER_SECRET=replace-with-a-random-server-only-secret

# The local server defaults to 127.0.0.1:4173. Render supplies PORT and requires
# HOST=0.0.0.0, which is already declared in render.yaml.
HOST=127.0.0.1
PORT=4173

# Optional Playwright integration-test settings. Use a dedicated Supabase project.
# E2E_BASE_URL=http://127.0.0.1:4173
# E2E_TEST_EMAIL=modu-brain-e2e@example.com
