# AI providers (server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
AI_PROVIDER=gemini
ALLOW_LIVE_OPENAI=false
ALLOW_LIVE_GEMINI=false

# Supabase persistence (server only; keep disabled until table and local access are ready)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_OPPORTUNITIES_TABLE=opportunity_analyses
ALLOW_SUPABASE_PERSISTENCE=false

# Local-safe runtime defaults
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
SERVE_CLIENT=false
PUBLIC_URL=http://127.0.0.1:3001
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY=false

# Basic unauthenticated analysis protection (production default: enabled)
ANALYZE_RATE_LIMIT_ENABLED=false
ANALYZE_RATE_LIMIT_MAX=10
ANALYZE_RATE_LIMIT_WINDOW_MS=60000

# Registered notice discovery cache (no arbitrary URLs are fetched)
DISCOVERY_CACHE_TTL_MS=300000
