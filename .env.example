# Supabase 프로젝트 설정 > API 에서 확인할 수 있습니다.
# 이 값들은 클라이언트에 노출되는 공개 키이지만, 실제 프로젝트 URL/키는 커밋하지 마세요.

# Supabase 프로젝트 URL (예: https://xxxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon(public) API 키
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# 아래는 Supabase Edge Functions(서버 사이드) 및 로컬 스크립트(scripts/*.mjs)용
# 시크릿입니다. 절대 커밋하지 말고, `supabase secrets set` 등으로 별도 관리하세요.
# 단, SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY는 Supabase Edge Functions 런타임에
# 배포 시 자동 주입되므로 원격 배포에서는 별도 설정이 필요 없습니다
# (로컬에서 scripts/*.mjs를 실행할 때만 이 .env 값이 필요합니다).
# ---------------------------------------------------------------------------

# Supabase 프로젝트 URL (Edge Functions 런타임에는 자동 주입됨, 로컬 스크립트 실행용)
SUPABASE_URL=

# Supabase 서비스 롤(service role) 키 — RLS를 우회하는 관리자 권한 키, 절대 노출 금지
# (Edge Functions 런타임에는 자동 주입됨, 로컬 스크립트 실행용)
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API 키 (자연어 조건 파싱 / 복기 에이전트) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Discord 애플리케이션(봇) ID — Discord Developer Portal > General Information
DISCORD_APPLICATION_ID=

# Discord 인터랙션 서명 검증용 공개 키 — Discord Developer Portal > General Information
DISCORD_PUBLIC_KEY=

# Discord 봇 토큰 — Discord Developer Portal > Bot, 채널 메시지 발송/커맨드 등록에 사용
DISCORD_BOT_TOKEN=

# Discord 길드(서버) ID (선택) — 지정하면 해당 길드에만 즉시 반영되는 커맨드로 등록됨
# (미지정 시 글로벌 커맨드로 등록되며 전파에 최대 1시간 소요)
# DISCORD_GUILD_ID=

# 한국투자증권(KIS) Open API 앱 키 — https://apiportal.koreainvestment.com
KIS_APP_KEY=

# 한국투자증권(KIS) Open API 앱 시크릿
KIS_APP_SECRET=

# 알림 연결 (scripts/link-discord.mjs 실행용)
DISCORD_USER_ID=
DISCORD_NOTIFY_CHANNEL_ID=
