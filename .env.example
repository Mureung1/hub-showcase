# Client-side feature flags. Do not put provider API keys in Vite env variables.
VITE_CURRICULUM_RECOMMENDATION_MODE=server
VITE_ICU_API_MODE=server
VITE_API_BASE_URL=
VITE_CODE_RUNNER_BASE_URL=
VITE_ICU_PREVIEW_URL=http://127.0.0.1:5174/preview.html
VITE_ICU_APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Server-side only. Keep the real value in .env or the backend host secret store.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
CURRICULUM_AGENT_PORT=8787
JUDGE_PORT=8790
ICU_ALLOWED_ORIGIN=

# Repository roles: in-memory (tests/mock), sqlite (local/offline), supabase (deployed persistence).
ICU_REPOSITORY_MODE=in-memory
ICU_SQLITE_PATH=.icu/icu.sqlite

# Server-side Supabase credentials. Never expose SUPABASE_SECRET_KEY through VITE_* variables.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
