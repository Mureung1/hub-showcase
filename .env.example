# 실제 값은 .env에 넣는다. 이 파일에는 키 이름과 설명만 남긴다.
# 새 환경변수를 추가하면 여기에도 반드시 추가한다.
#
# Supabase는 publishable/secret 키 체계를 사용한다.
# legacy anon/service_role 키는 쓰지 않는다. (2026년 말 제거 예정)

# --- 백엔드 (backend/.env) ---
# 브라우저에 노출되지 않는다. 시크릿을 여기에 둔다.
#
# SUPABASE_SECRET_KEY(sb_secret_...)는 RLS를 우회하고 DB 전체에 접근한다.
# 절대 프론트엔드나 저장소에 넣지 않는다.

# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
#
# 사용자 요청을 대신 보낼 때 사용자 JWT와 함께 쓴다. 이때는 RLS가 적용된다.
# 공개 키이므로 백엔드에 있어도 위험하지 않다.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# CORS 허용 오리진. 쉼표로 구분. 개발 중엔 Vite 프록시를 쓰므로 기본값으로 충분하다.
# CORS_ALLOW_ORIGINS=http://localhost:5173

# --- 프론트엔드 (frontend/.env) ---
# VITE_ 접두사가 붙은 값은 번들에 포함되어 브라우저에 그대로 노출된다.
# 공개해도 되는 값만 둔다. 시크릿은 절대 넣지 않는다.
#
# PUBLISHABLE_KEY(sb_publishable_...)는 공개용이며 RLS가 적용된다.

# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
