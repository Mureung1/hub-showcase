# Supabase access token (optional — GET /consult-requests/me until login UI exists)
# VITE_SUPABASE_ACCESS_TOKEN=

# 백엔드 API (Vite dev: /api 프록시 → http://localhost:5001, 기본값 빈 문자열)
# VITE_API_BASE_URL=

# Ollama AI 추천 설정 (선택)
# 로컬 Ollama 기본 주소. Vite dev 서버에서는 /ollama 프록시 사용 (기본값)
# VITE_OLLAMA_URL=http://localhost:11434

# 사용할 Ollama 모델 (ollama pull 로 미리 다운로드)
VITE_OLLAMA_MODEL=llama3.2

# 네이버 지도 (NCP Application > Maps > Dynamic Map)
# 1) https://console.ncloud.com/ 에서 Application 생성
# 2) Maps > Dynamic Map 활성화
# 3) Web Service URL에 http://localhost:5173 등록 (포트 제외한 호스트만 요구되면 localhost)
# 4) 발급된 ncpKeyId(Client ID)를 아래에 넣고 파일을 .env.local 로 복사
VITE_NAVER_MAP_CLIENT_ID=