# Supabase Auth (로그인 UI 전까지 식단·상담 API용)
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# (Vercel 배포) OAuth 리다이렉트용 — Supabase Site URL과 동일하게 설정
# VITE_SITE_URL=https://hub-tan-pi.vercel.app
#
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL:        https://hub-tan-pi.vercel.app  (배포 도메인)
#   Redirect URLs: https://hub-tan-pi.vercel.app/auth/callback
#                  https://hub-tan-pi.vercel.app/reset-password
#                  http://localhost:5173/auth/callback
#                  http://localhost:5173/reset-password
# ※ Site URL이 localhost:3000 이면 Google 로그인 후 localhost:3000 으로 튕깁니다.

# (선택) 토큰을 env로 직접 넣을 때 — DevAuthPanel 사용 시 불필요
# VITE_SUPABASE_ACCESS_TOKEN=

# 백엔드 API (Vite dev: /api 프록시 → http://localhost:5001, 기본값 빈 문자열)
# VITE_API_BASE_URL=

# Ollama AI 추천 설정 (선택)
# 로컬 Ollama 기본 주소. Vite dev 서버에서는 /ollama 프록시 사용 (기본값)
# VITE_OLLAMA_URL=http://localhost:11434

# 사용할 Ollama 모델 (ollama pull 로 미리 다운로드)
VITE_OLLAMA_MODEL=llama3.2

# 네이버 지도 (NCP Application > Maps > Dynamic Map)
# 1) https://console.ncloud.com/ 에서 Application 생성
# 2) Maps > Dynamic Map 활성화
# 3) Web Service URL에 http://localhost:5173 등록 (포트 제외한 호스트만 요구되면 localhost)
# 4) 발급된 ncpKeyId(Client ID)를 아래에 넣고 파일을 .env.local 로 복사
VITE_NAVER_MAP_CLIENT_ID=