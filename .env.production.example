# Application
NODE_ENV=production
PORT=3000
BACKEND_PORT=3000

# MySQL container
MYSQL_DATABASE=iris
MYSQL_USER=iris
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# Backend database connection inside docker-compose.prod.yml
DATABASE_URL=mysql://iris:change-me@mysql:3306/iris

# Discord
DISCORD_BOT_TOKEN=change-me
DISCORD_CLIENT_ID=change-me

# Frontend URL used by the Discord /setup command
ADMIN_WEB_URL=https://your-vercel-app.vercel.app
