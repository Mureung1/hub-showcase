# apps/web 프론트 환경변수 (VITE_ 접두사 = 브라우저에 공개되는 값)
# 실제 값은 apps/web/.env.local 에 두고 커밋하지 않는다. 이 파일(.env.example)만 커밋한다.

VITE_API_BASE_URL=http://localhost:4000

# Supabase (SPEC-AUTH-001) — 프론트에는 URL과 Publishable Key만 둔다.
# Secret Key·Service Role Key·AI API Key 등 비밀값은 절대 프론트에 두지 않는다.
# 값은 Supabase 대시보드 > Project Settings > API 에서 확인한다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
