API_PORT=3000
CORS_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@SESSION_POOLER_HOST:5432/postgres
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
# Local Supabase pooler only. External deployment must use true with a trusted CA.
DB_SSL_REJECT_UNAUTHORIZED=false
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
BACKGROUND_JOB_INTERVAL_MS=60000

# Brevo SMTP credentials belong in Supabase Auth > SMTP Settings, not in this file.
