# apps/api 백엔드 환경변수
# 실제 값은 apps/api/.env 에 두고 커밋하지 않는다. 이 파일(.env.example)만 커밋한다.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Supabase (SPEC-AUTH-003) — 서버 시작 시 Zod로 검증하는 필수 값.
# URL·Publishable Key는 프론트(apps/web/.env.local)와 같은 프로젝트 값을 쓴다.
# 값은 Supabase 대시보드 > Project Settings > API 에서 확인한다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Secret Key — RLS를 우회하는 시스템 쓰기용. DB Spec(SPEC-DB-001)에서 사용·필수화한다.
# 이번 Spec(SPEC-AUTH-003)에서는 사용하지 않으며 검증하지 않는다.
SUPABASE_SECRET_KEY=

# AI API Key — 각 AI Spec에서 사용·필수화한다. 비밀값이므로 백엔드에서만 둔다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
