API_PORT=3000
CORS_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
PATIENT_WEB_ORIGIN=http://127.0.0.1:5173
# Fallback hospital context used only when development auth bypass is enabled.
STAFF_HOSPITAL_ID=10000000-0000-4000-8000-000000000001
ALLOW_DEV_STAFF_AUTH_BYPASS=false
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@SESSION_POOLER_HOST:5432/postgres
DEVELOPMENT_STAFF_PASSWORD=
DEVELOPMENT_PLATFORM_PASSWORD=
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
# Local Supabase pooler only. External deployment must use true with a trusted CA.
DB_SSL_REJECT_UNAUTHORIZED=false
BACKGROUND_JOB_INTERVAL_MS=60000

# Brevo SMTP credentials belong in Supabase Auth > SMTP Settings, not in this file.
