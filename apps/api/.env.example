# apps/api 백엔드 환경변수
# 실제 값은 apps/api/.env 에 두고 커밋하지 않는다. 이 파일(.env.example)만 커밋한다.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Supabase (SPEC-AUTH-003) — 서버 시작 시 Zod로 검증하는 필수 값.
# URL·Publishable Key는 프론트(apps/web/.env.local)와 같은 프로젝트 값을 쓴다.
# 값은 Supabase 대시보드 > Project Settings > API 에서 확인한다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Secret Key (SPEC-DB-001) — RLS를 우회하는 시스템 쓰기 클라이언트용. 서버 시작 시 필수 검증.
# 값은 Supabase 대시보드 > Project Settings > API 의 secret/service_role 키.
SUPABASE_SECRET_KEY=

# BYOK 키 암호화 마스터 키 (SPEC-DB-001) — AES-256-GCM. base64로 인코딩된 32바이트.
# 예: `openssl rand -base64 32` 로 생성. 서버 시작 시 필수 검증(base64 32바이트).
AI_KEY_ENCRYPTION_KEY=

# 마이그레이션 적용용 Postgres 연결 문자열 (SPEC-DB-001) — `supabase db push --db-url` 에 사용.
# 값은 Supabase 대시보드 > Project Settings > Database 의 connection string(비밀번호 포함).
# 서버 런타임은 사용하지 않으므로 env.ts 검증 대상 아님. 커밋 금지.
SUPABASE_DB_URL=

# AI API Key — 각 AI Spec에서 사용·필수화한다. 비밀값이므로 백엔드에서만 둔다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Manager(비교·분류 엔진, SPEC-AI-002 §15.2) — 내부 엔진이라 앱 키만 쓴다(BYOK 아님).
# OPENROUTER_API_KEY·MANAGER_MODEL은 서버 시작 시 필수 검증(없으면 기동 실패). 비밀값이므로 커밋 금지.
OPENROUTER_API_KEY=
MANAGER_MODEL=
# 아래는 선택(기본값 있음). 비워두면 코드 기본값을 쓴다.
MANAGER_PROMPTS_DIR=
CLASSIFIER_PROMPT_VERSION=
COMPARATOR_PROMPT_VERSION=
MANAGER_CONFLICT_TYPES=
MANAGER_CONCURRENCY=
MANAGER_TIMEOUT_MS=
