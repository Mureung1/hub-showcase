{
  "name": "@baro-jinryo/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run src --exclude \"src/**/*.integration.test.ts\"",
    "test:integration": "vitest run .integration.test.ts",
    "db:seed:development": "tsx src/scripts/seedDevelopment.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@baro-jinryo/shared": "0.1.0",
    "@supabase/supabase-js": "^2.110.5",
    "cors": "^2.8.0",
    "dotenv": "^17.0.0",
    "express": "^5.2.0",
    "pg": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
