{
  "name": "@ay-ple/inspector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "npm run test:camp-demo && npm run test:e2e",
    "test:camp-demo": "tsx --test ../../artifacts/camp-demo/product-flow/product-demo-core.test.mts ../../artifacts/camp-demo/export-pdf.test.mts",
    "test:e2e": "NODE_OPTIONS=--conditions=development playwright test --config playwright.config.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "serve:camp-demo": "vite ../.. --host 127.0.0.1 --port 4174 --strictPort --open /artifacts/camp-demo/",
    "export:camp-demo": "tsx ../../artifacts/camp-demo/export-pdf.mts"
  },
  "dependencies": {
    "@ay-ple/runtime-codex": "0.0.0",
    "@ay-ple/runtime-core": "0.0.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
