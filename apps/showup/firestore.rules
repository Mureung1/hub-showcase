// Firestore Security Rules - ShowUp Security Session
// Owner UID based store isolation and field validation
service cloud.firestore {
  match /databases/{database}/documents {
    // Store level isolation: only owner can read/write the store document
    match /stores/{storeId} {
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // Customers sub-collection: only store owner can access
      match /customers/{customerId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid;
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.phone is string
          && request.resource.data.phoneLast4 is string;
        allow update, delete: if request.auth != null
          && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid;
      }

      // Other sub-collections (reservations, incidents, etc.) — wildcard for now
      match /{document=**} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid;
      }
    }
  }
}