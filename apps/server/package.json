{
  "name": "@ay-ple/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch src/server.ts",
    "build": "tsc",
    "verify:codex-parity": "NODE_OPTIONS=--conditions=development tsx src/codex-parity.ts",
    "test": "NODE_OPTIONS=--conditions=development tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@ay-ple/runtime-core": "0.0.0",
    "@ay-ple/runtime-codex": "0.0.0",
    "@ay-ple/runtime-fake": "0.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  }
}
