# 서버(apps/server) 환경변수 예시 — 실제 값은 .env 에 두고 커밋하지 않는다.
# 실행: npm run dev (루트) 또는 apps/server 에서 tsx --env-file=.env

# 날씨 (앙상블)
KMA_SERVICE_KEY=      # 공공데이터포털 기상청 단기예보 서비스키
OWM_API_KEY=          # OpenWeatherMap API 키

# DB (Supabase)
SUPABASE_URL=
SUPABASE_SECRET_KEY=  # service_role/secret 키 (서버 전용, RLS 우회)

# LLM
GROQ_API_KEY=

# 문자 (Solapi) — 아래 3개가 모두 없으면 dry-run(실발송 안 함)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=        # 등록된 발신번호
SOLAPI_TEST_TO=       # 실발송 테스트 수신번호(본인) — 더미 단골 실발송 금지 원칙
OWNER_PHONE=          # 사장님 알림(운영) 수신번호. 없으면 SOLAPI_TEST_TO 사용

# CORS (실연동 시 웹 오리진 화이트리스트, 콤마 구분)
CORS_ORIGINS=http://localhost:5173
