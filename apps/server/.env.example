# 서버(apps/server) 환경변수 예시 — 실제 값은 .env 에 두고 커밋하지 않는다.
# 실행: npm run dev (루트) 또는 apps/server 에서 tsx --env-file=.env

# 날씨 (앙상블)
KMA_SERVICE_KEY=      # 공공데이터포털 기상청 단기예보 서비스키
OWM_API_KEY=          # OpenWeatherMap API 키

# DB (Supabase)
SUPABASE_URL=
SUPABASE_SECRET_KEY=  # service_role/secret 키 (서버 전용, RLS 우회)

# LLM
GROQ_API_KEY=

# 문자 (Solapi) — 아래 3개가 모두 없으면 dry-run(실발송 안 함)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=        # 등록된 발신번호
SOLAPI_TEST_TO=       # 실발송 테스트 수신번호(본인) — 더미 단골 실발송 금지 원칙
OWNER_PHONE=          # 사장님 알림(운영) 수신번호. 없으면 SOLAPI_TEST_TO 사용

# Instagram 게시 (Content Publishing) — 아래가 없으면 게시 안 함(복사 폴백)
# 본인 프로페셔널 계정만. 앱 개발모드면 App Review 불필요. Instagram은 이미지 필수.
IG_USER_ID=           # IG 비즈니스 계정의 ig-user-id
IG_ACCESS_TOKEN=      # instagram_business_content_publish 권한 장기 토큰(~60일)
IG_API_HOST=          # 기본 graph.facebook.com (IG Login 방식이면 graph.instagram.com)
IG_DEMO_IMAGE_URL=    # 게시할 공개 프로모 이미지 URL(공개 접근 가능해야 함)

# CORS (실연동 시 웹 오리진 화이트리스트, 콤마 구분)
CORS_ORIGINS=http://localhost:5173
