# 서버(apps/server) 환경변수 예시 — 실제 값은 .env 에 두고 커밋하지 않는다.
# 실행: npm run dev (루트) 또는 apps/server 에서 tsx --env-file=.env

# 날씨 (앙상블)
KMA_SERVICE_KEY=      # 공공데이터포털 기상청 단기예보 서비스키
OWM_API_KEY=          # OpenWeatherMap API 키

# DB (Supabase)
SUPABASE_URL=
SUPABASE_SECRET_KEY=  # service_role/secret 키 (서버 전용, RLS 우회)

# LLM
GROQ_API_KEY=

# 문자 (Solapi) — 아래 3개가 모두 없으면 dry-run(실발송 안 함)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=        # 등록된 발신번호
SOLAPI_TEST_TO=       # 실발송 테스트 수신번호(본인) — 더미 단골 실발송 금지 원칙
OWNER_PHONE=          # 사장님 알림(운영) 수신번호. 없으면 SOLAPI_TEST_TO 사용

# Instagram 게시 (Content Publishing) — 아래가 없으면 게시 안 함(복사 폴백)
# 본인 프로페셔널 계정만. 앱 개발모드면 App Review 불필요. Instagram은 이미지 필수.
# ⚠️ 이미지 제약: JPEG만(PNG·WEBP·HEIC 거부) · 비율 4:5~1.91:1 · 최대 8MB.
IG_USER_ID=           # IG 비즈니스 계정의 ig-user-id
IG_ACCESS_TOKEN=      # instagram_business_content_publish 권한 장기 토큰(~60일)
IG_API_HOST=          # 보통 비워둔다 — 토큰 접두사로 자동 판별(IGAA…→graph.instagram.com, EAA…→graph.facebook.com)
                      # 짝이 안 맞으면 190 "Cannot parse access token"이 뜬다(토큰이 아니라 호스트 문제)
IG_API_VERSION=       # 기본 v21.0
IG_DEMO_IMAGE_URL=    # 게시할 공개 프로모 이미지 URL(메타 서버가 직접 fetch하므로 공개 접근 필수)
                      # 기본 카드: https://weatherpilot-web.vercel.app/promo-card.jpg

# CORS (실연동 시 웹 오리진 화이트리스트, 콤마 구분)
CORS_ORIGINS=http://localhost:5173

# 데모 고정 날씨 (5-1) — 비워두면 평소대로 실제 예보 API를 쓴다. 발표 당일에만 켠다.
# 발표일 날씨가 맑으면 "매출 방어" 서사가 성립하지 않아, **날씨 입력만** 고정한다.
# 진단·LLM 문구·발송·쿠폰 추적은 전부 그대로 실제로 돈다.
# 켜면 화면 배지가 "데모 고정 날씨 (실제 예보 API 미사용)"로 바뀐다 — 실측인 척하지 않는다.
# 값: rain(기본 데모) | clear | cold | heat  — 오타는 경고 로그 후 실 API로 폴백
# 반영 시점: 서버 재시작 시 기동 잡이 오늘 제안을 다시 만든다.
DEMO_WEATHER=
