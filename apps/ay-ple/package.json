  "scripts": {
    "build": "tsc",
    "test": "NODE_OPTIONS=--conditions=development tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ay-ple/runtime-release": "0.0.0",
    "@ay-ple/semester-workspace": "0.0.0",
    "@ay-ple/server": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2"
  }
}
