{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-bulk-git.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-before-commit.sh\"",
            "timeout": 60,
            "statusMessage": "커밋 전 oxlint 검사 중..."
          }
        ]
      }
    ]
  }
}
