{
  "name": "@placepick/edge-security",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm run test && npm run config:check",
    "config:check": "wrangler deploy --config wrangler.release-gate.jsonc --dry-run && wrangler deploy --config wrangler.provider-gateway.jsonc --dry-run",
    "dev:provider-gateway": "wrangler dev --config wrangler.provider-gateway.jsonc",
    "dev:release-gate": "wrangler dev --config wrangler.release-gate.jsonc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260714.1",
    "@cloudflare/vitest-pool-workers": "0.18.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  }
}
