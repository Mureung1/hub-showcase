# 이 파일은 합성 키를 사용하는 로컬 테스트의 변수명 목록일 뿐이다.
# 실제 Naver 키를 edge/.dev.vars에 복사하지 않는다. 배포 단계에서는 각 Worker에 필요한
# 값만 `wrangler secret put`으로 분리해 등록한다.
RELEASE_GATE_SIGNING_PRIVATE_JWK=
RELEASE_GATE_SIGNING_PUBLIC_JWK=
RELEASE_GATE_SIGNING_KEY_ID=
GITHUB_CONTENTS_READ_TOKEN=
NAVER_LIVE_WORKFLOW_SHA256=
NAVER_API_HUB_KEY_ID=
NAVER_API_HUB_KEY=
