{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "placepick-release-gate",
  "main": "src/release-gate/worker.ts",
  "compatibility_date": "2026-07-14",
  "workers_dev": false,
  "vars": {
    "PROVIDER_GATEWAY_ORIGIN": "https://provider-gateway.invalid"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REPLAY_STORE",
        "class_name": "ReplayDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ReplayDurableObject"
      ]
    }
  ]
}
