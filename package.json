{
  "name": "teamflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.14 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @teamflow/web",
    "dev:web": "npm run dev --workspace @teamflow/web",
    "dev:api": "npm run dev --workspace @teamflow/api",
    "build": "npm run build --workspace @teamflow/web",
    "lint": "oxlint apps packages",
    "test": "npm run test --workspaces --if-present",
    "preview": "npm run preview --workspace @teamflow/web"
  },
  "devDependencies": {
    "oxlint": "^1.71.0"
  }
}
