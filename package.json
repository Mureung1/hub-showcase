{
  "name": "hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "predev": "npm run build -w shared",
    "dev": "concurrently -n client,server -c blue,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w shared && npm run build -w client && npm run build -w server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pretest": "npm run build -w shared",
    "test": "npm run test -w client && npm run test -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "concurrently": "^9.0.1",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "mermaid": "^11.16.0",
    "playwright": "^1.61.1",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0"
  }
}
