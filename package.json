{
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "verify:sprites": "node scripts/verify-sprite-sheets.mjs",
    "review:sprites": "vite --host 127.0.0.1 --port 5174 --open \"/?review=sprites\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "hono": "^4.12.30",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
