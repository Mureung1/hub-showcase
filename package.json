{
  "name": "gazua-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @gazua/frontend dev",
    "build": "pnpm --filter @gazua/frontend build",
    "preview": "pnpm --filter @gazua/frontend preview",
    "typecheck": "pnpm --filter @gazua/frontend typecheck",
    "lint": "pnpm --filter @gazua/frontend lint",
    "format": "pnpm --filter @gazua/frontend format",
    "format:check": "pnpm --filter @gazua/frontend format:check",
    "test": "pnpm --filter @gazua/frontend test",
    "test:watch": "pnpm --filter @gazua/frontend test:watch"
  }
}
