{
  "name": "baro-jinryo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "predev": "npm run build -w @baro-jinryo/shared",
    "dev": "concurrently -k -n shared,api,web -c yellow,cyan,green \"npm run dev -w @baro-jinryo/shared\" \"npm run dev -w @baro-jinryo/api\" \"npm run dev -w @baro-jinryo/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "pretypecheck": "npm run build -w @baro-jinryo/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build -w @baro-jinryo/shared",
    "test": "npm run test --workspaces --if-present",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migration:new": "supabase migration new",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/**/*.{ts,json}\" \"*.{js,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/**/*.{ts,json}\" \"*.{js,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.0",
    "supabase": "^2.109.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
