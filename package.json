{
  "name": "placepick-ai-repository-policy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docs:lint": "markdownlint-cli2 --config tools/docs/markdownlint-cli2.jsonc \"README.md\" \"AGENTS.md\" \"docs/**/*.md\" \".github/**/*.md\"",
    "docs:validate": "node tools/docs/validate.mjs",
    "docs:check": "npm run docs:lint && npm run docs:validate",
    "docs:test": "node --test tools/docs/tests/*.test.mjs",
    "docs:links:external": "node tools/docs/external-links.mjs",
    "test": "npm run docs:test"
  },
  "devDependencies": {
    "markdown-link-check": "3.14.2",
    "markdownlint-cli2": "0.23.0",
    "yaml": "2.9.0"
  }
}
