{
  "name": "opportunity-agent-intro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "client:dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "server:dev": "nodemon --exitcrash server/index.js",
    "dev": "concurrently --kill-others-on-fail --names server,client --prefix-colors blue,green \"npm run server:dev\" \"npm run client:dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "verify:requirements": "node scripts/requirementValidationAgent.mjs",
    "verify:requirements:fast": "node scripts/requirementValidationAgent.mjs --skip-build"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@supabase/supabase-js": "^2.110.6",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.9",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
