{
  "name": "hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "docs:priority": "node scripts/docs-update-priority.mjs",
    "agent:curriculum": "node scripts/curriculum-planner-agent.mjs",
    "server:curriculum": "node backend/curriculum-agent-server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier AGENTS.md README.md package.json tsconfig.json eslint.config.js index.html prototype.html prototype.css \"scripts/**/*.mjs\" \"src/**/*.{ts,tsx,css}\" --write",
    "format:check": "prettier AGENTS.md README.md package.json tsconfig.json eslint.config.js index.html prototype.html prototype.css \"scripts/**/*.mjs\" \"src/**/*.{ts,tsx,css}\" --check",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}

