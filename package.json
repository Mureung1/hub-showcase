{
  "name": "ptop",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "start": "npm run start --workspace @ptop/api",
    "dev:web": "npm run dev --workspace @ptop/web",
    "dev:api": "npm run start:dev --workspace @ptop/api",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test --workspace @ptop/web",
    "test:api": "npm run test --workspace @ptop/api",
    "evaluate:ai": "node scripts/evaluate-openai-models.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:web": "npm run typecheck --workspace @ptop/web",
    "typecheck:api": "npm run typecheck --workspace @ptop/api",
    "typecheck:contracts": "npm run typecheck --workspace @ptop/contracts",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @ptop/web",
    "build:api": "npm run build --workspace @ptop/api",
    "predeploy": "npm run build:web"
  }
}
