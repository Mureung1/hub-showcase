{
  "name": "hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:preview": "vite --config vite.preview.config.js",
    "dev:server": "node scripts/dev-with-backend.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "build": "npm run typecheck && npm run build:app && npm run build:preview",
    "build:app": "vite build",
    "build:preview": "vite build --config vite.preview.config.js",
    "preview": "vite preview",
    "start": "node backend/http/server.mjs",
    "docs:priority": "node scripts/docs-update-priority.mjs",
    "agent:curriculum": "node scripts/curriculum-planner-agent.mjs",
    "knowledge:validate": "node scripts/validate-knowledge-chunks.mjs",
    "server:curriculum": "node backend/http/server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier AGENTS.md README.md package.json tsconfig.json eslint.config.js index.html prototype.html prototype.css \"scripts/**/*.mjs\" \"src/**/*.{ts,tsx,css}\" --write",
    "format:check": "prettier AGENTS.md README.md package.json tsconfig.json eslint.config.js index.html prototype.html prototype.css \"scripts/**/*.mjs\" \"src/**/*.{ts,tsx,css}\" --check",
    "test": "vitest run",
    "smoke:supabase": "node scripts/supabase-smoke.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@supabase/supabase-js": "^2.110.8",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-router": "^8.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
