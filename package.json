{
  "name": "albanote",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @albanote/frontend\" \"npm run dev --workspace @albanote/backend\"",
    "dev:frontend": "npm run dev --workspace @albanote/frontend",
    "dev:backend": "npm run dev --workspace @albanote/backend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10"
  }
}
