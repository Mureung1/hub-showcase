{
  "name": "hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev --workspace server",
    "dev:all": "concurrently -n web,api -c blue,magenta \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "build:server": "npm run build --workspace server",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "npm run test --workspace server",
    "test:all": "npm run test && npm run test:server",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "^5.7.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
