{
  "name": "survival-study-challenge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Survival Study Challenge - Supabase (PostgreSQL) backend. Foundation scaffolding: migrations, pgTAP DB tests, and a TypeScript test environment (Vitest + fast-check + supabase-js).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:prove": "pg_prove --ext .sql -d \"$DATABASE_URL\" supabase/tests"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.5",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "0.31.10",
    "fast-check": "^4.9.0",
    "supabase": "^2.109.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
