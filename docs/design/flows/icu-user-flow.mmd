    start --> hub
    hub --> choose
    choose -->|"새 목표"| goal
    choose -->|"이어서 학습"| moduleEntry
    choose -->|"오답 전체보기"| notes

    goal --> curriculum
    curriculum --> moduleEntry

    moduleEntry --> workspace
    moduleEntry --> gitlab
    moduleEntry -. "후속 확장" .-> futureModules

    workspace --> attempt
    gitlab --> attempt
    futureModules --> attempt

    attempt --> result
    result -->|"예"| feedback
    result -->|"아니요"| saveMistake

    feedback --> progress
    feedback --> review
    saveMistake --> progress
    saveMistake --> notes

    review -->|"전체보기"| notes
    notes -->|"다시 풀기"| retry
    retry --> moduleEntry

    progress -. "현재 mock persistence" .-> hub
    progress -. "나중에 이전" .-> futureStore

