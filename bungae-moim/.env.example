# 이 파일을 .env로 복사한 뒤 값을 채우세요.
# Vite는 VITE_ 로 시작하는 변수만 브라우저 코드에 노출합니다.
# 여기 있는 값은 모두 공개돼도 되는 정보입니다(클라이언트 시크릿은 백엔드 .env에만 둡니다).

VITE_GOOGLE_CLIENT_ID=
VITE_KAKAO_CLIENT_ID=

# 구글/카카오 콘솔에 등록한 리다이렉트 URI와 정확히 같아야 하고,
# 백엔드 .env의 OAUTH_REDIRECT_URI와도 같아야 합니다.
VITE_OAUTH_REDIRECT_URI=http://localhost:5173
