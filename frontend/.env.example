# 프론트엔드 환경변수 예시.
# 로컬 개발에서는 아무것도 설정하지 않아도 된다(Vite 프록시가 localhost:3001 로 넘긴다).
# 배포(Vercel)에서만 아래 값을 설정한다.

# Render 에 배포한 API 서버 주소. 끝에 "/" 나 "/api" 를 붙이지 않는다.
# 예) https://exam-priority-server.onrender.com
VITE_API_BASE_URL=

# 정적 파일 경로 접두사. Vercel 은 비워두면 '/' 다.
# GitHub Pages 에 올릴 때만 /hub/ 로 둔다(= npm run build:pages).
# VITE_BASE_PATH=/hub/
