VITE_API_BASE_URL=http://localhost:4000

# Supabase Auth (로그인/회원가입). 값은 Supabase 프로젝트 설정 > API에서 발급.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 편지 작성 화면의 붙여넣기 금지는 "직접 쓰는 편지"라는 제품 취지상 일부러 막아둔 것이라 기본은
# 금지(false)다. 매칭 품질 테스트 때 다양한 데이터를 빠르게 넣어보려면 true로 켠다.
# 배포 전에는 반드시 false로 되돌리거나 이 줄을 지울 것.
VITE_ALLOW_PASTE=false
