{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "functions/**",
      "node_modules/**",
      "api/**",
      "db/**",
      "scoring/**",
      "package.json",
      "package-lock.json",
      "README.md",
      "deploy.sh",
      "**/.*"
    ],
    "rewrites": []
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
