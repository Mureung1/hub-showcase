# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Dotfiles are not committed by default.
# Add an explicit allowlist only when a dotfile is required for the repo.
.*
**/.*
!.gitignore
.env
.env.*
!.env.example
!**/.env.example
!.gitkeep
!**/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
