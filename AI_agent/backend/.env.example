# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Optional comma-separated allowlist. Use this when production and preview frontends both call the same API.
FRONTEND_ORIGINS=http://localhost:5173,https://career-mission-ai.vercel.app

# PostgreSQL connection used by Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_mission_ai

# JWT issued after Firebase token verification.
# Use a long random value in production.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# OpenAI. Leave OPENAI_API_KEY empty to rely on fallback responses where supported.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-nano
OPENAI_FEEDBACK_ENABLED=true
OPENAI_FILE_FEEDBACK_ENABLED=true

# Submission upload limit in bytes. Default is 5 MB.
SUBMISSION_FILE_MAX_BYTES=5242880

# External career/search APIs. Empty values enable local fallback data where supported.
CAREER_NET_API_KEY=your_career_net_api_key
PUBLIC_DATA_API_KEY=your_public_data_api_key
SEARCH_CACHE_TTL_MS=600000

# SMTP mail delivery for verification emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
SMTP_FROM="Career Mission AI <your_gmail_address@gmail.com>"

# Optional Resend mail delivery settings.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM="Career Mission AI <onboarding@resend.dev>"

# Firebase Admin SDK service account for backend token verification.
# Keep the escaped newline form for FIREBASE_PRIVATE_KEY in .env files.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
