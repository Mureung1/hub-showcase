# Backend API origin used by frontend fetch helpers.
VITE_API_BASE_URL=http://localhost:4000

# Optional footer/contact links.
VITE_GITHUB_URL=https://github.com/your-id
VITE_DISCORD_URL=https://discord.com/users/your-id
VITE_CONTACT_EMAIL=your-email@example.com

# Firebase Web App config for client-side authentication.
# Copy these values from Firebase Console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
