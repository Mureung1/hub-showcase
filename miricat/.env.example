# LLM (구조화 추출 / 문장 조립) — 기본 Claude
ANTHROPIC_API_KEY=
# LLM (데모: Gemini 사용) — Google AI Studio에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 경로 / 지오코딩 — 네이버지도 (자차 Directions, 도로명 포함)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# 대중교통 경로 — ODsay (노선번호 / 정류장 목록)
ODSAY_API_KEY=

# 알림 — 디스코드 웹훅
DISCORD_WEBHOOK_URL=
# 경보 링크가 가리킬 리포트 웹 주소 (배포 후엔 Vercel URL로 교체)
REPORT_BASE_URL=http://localhost:5173

# 관측성 — Langfuse (셀프호스트)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# DB — Supabase (API 서버). URL은 프로젝트 대시보드 Settings→API의 Project URL
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# DB — 3주차 Python 워커용 (LangGraph/eval)
DATABASE_URL=sqlite:///./miricat.db
