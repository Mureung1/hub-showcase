# 테스트 실행 시 사용하는 환경변수 (복사해서 .env.test로 저장)
# 반드시 개발 DB(bungae)와 다른, 테스트 전용 DB(bungae_test)를 가리켜야 한다.
# tests/loadTestEnv.js, tests/globalSetup.js가 DATABASE_URL에 "bungae_test"가
# 포함되어 있는지 확인하고, 아니면 즉시 에러를 던져 테스트를 중단시킨다.

NODE_ENV=test
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bungae_test
SESSION_SECRET=test-session-secret
