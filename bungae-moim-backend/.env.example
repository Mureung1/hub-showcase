# 서버 포트
PORT=3000

# PostgreSQL 연결 문자열 (로컬 개발 기본값: user=postgres, password=postgres, db=bungae)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bungae

# 세션 쿠키 서명에 사용할 비밀 키 (express-session, C2 태스크에서 사용)
SESSION_SECRET=changeme

# 구글 OAuth 클라이언트 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오 OAuth 클라이언트 정보
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
