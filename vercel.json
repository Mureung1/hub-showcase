{
  "version": 2,
  "builds": [
    { "src": "newssist/package.json", "use": "@vercel/static-build", "config": { "distDir": "build" } },
    { "src": "server/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "newssist/build/index.html" }
  ]
}
