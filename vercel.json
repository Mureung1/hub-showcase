{
  "buildCommand": "pnpm --dir apps/web build && node scripts/copy-docs.mjs",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "redirects": [
    {
      "source": "/prototype",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/prototype/(.*)",
      "destination": "/",
      "permanent": false
    }
  ]
}
