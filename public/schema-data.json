[
  {
    "table": "lessons",
    "description": "학습 과제 및 실습 단계 메타데이터",
    "columns": [
      { "name": "id", "type": "UUID", "key": "PK", "desc": "과제 고유 식별자" },
      { "name": "title", "type": "VARCHAR(255)", "key": "NOT NULL", "desc": "과제 제목" },
      { "name": "summary", "type": "TEXT", "key": "NOT NULL", "desc": "과제 요약 설명" },
      { "name": "created_at", "type": "TIMESTAMPTZ", "key": "DEFAULT now()", "desc": "생성 일시" }
    ]
  },
  {
    "table": "user_notes",
    "description": "사용자가 작성한 손코딩 메모",
    "columns": [
      { "name": "id", "type": "UUID", "key": "PK", "desc": "메모 고유 식별자" },
      { "name": "user_id", "type": "UUID", "key": "FK", "desc": "작성자 ID (auth.users)" },
      { "name": "lesson_id", "type": "UUID", "key": "FK", "desc": "연관 과제 ID" },
      { "name": "content", "type": "TEXT", "key": "NOT NULL", "desc": "메모 본문 내용" },
      { "name": "created_at", "type": "TIMESTAMPTZ", "key": "DEFAULT now()", "desc": "생성 일시" }
    ]
  },
  {
    "table": "quiz_responses",
    "description": "사용자 자가 진단 퀴즈 채점 이력",
    "columns": [
      { "name": "id", "type": "UUID", "key": "PK", "desc": "응답 고유 식별자" },
      { "name": "user_id", "type": "UUID", "key": "FK", "desc": "풀이 사용자 ID" },
      { "name": "quiz_id", "type": "INTEGER", "key": "FK", "desc": "퀴즈 문제 번호 ID" },
      { "name": "selected_index", "type": "INTEGER", "key": "NOT NULL", "desc": "선택한 답안 인덱스" },
      { "name": "is_correct", "type": "BOOLEAN", "key": "NOT NULL", "desc": "정답 여부" },
      { "name": "created_at", "type": "TIMESTAMPTZ", "key": "DEFAULT now()", "desc": "생성 일시" }
    ]
  }
]
