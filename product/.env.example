PUBLIC_DATA_SERVICE_KEY=
SEOUL_OPEN_DATA_KEY=
KOSIS_API_KEY=
# Server-only Supabase PostgreSQL URL. Keep the real value out of Git and the web bundle.
DATABASE_URL=
ENVIRONMENT=development
# Used only by development and test environments.
CORS_ORIGINS_LOCAL=http://127.0.0.1:5173,http://localhost:5173
# Required by staging and production. Never add localhost here.
CORS_ORIGINS_SERVER=https://localtwin-product.vercel.app
SCENE_API_ENABLED=false
SCENE_WORKER_MODE=host
SCENE_DOCKER_IMAGE=ghcr.io/nerfstudio-project/nerfstudio:1.1.5
# Scene API stays disabled in product until SEC-001 B has authentication. These limits apply
# whenever it is deliberately enabled; tune them in the server environment, never in VITE_*.
SCENE_UPLOAD_MAX_BYTES=1073741824
SCENE_STORAGE_QUOTA_BYTES=10737418240
SCENE_RATE_WINDOW_SECONDS=60
SCENE_MAX_JOBS_PER_WINDOW=3
SCENE_MAX_ACTIVE_JOBS=2
SCENE_WORKER_CONCURRENCY=1
SCENE_RETRY_COOLDOWN_SECONDS=60
SCENE_JOB_RETENTION_HOURS=72
SCENE_ANONYMIZATION_ACTION=blur
SCENE_PERSON_CONFIDENCE_THRESHOLD=0.5
SCENE_PERSON_BBOX_MARGIN=0.1
